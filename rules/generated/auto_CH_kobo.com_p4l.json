{
    "name": "auto_CH_kobo.com_p4l",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://www.kobo.com/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?kobo\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "[data-testid='privacy-banner'] [data-testid^='privacy-banner-decline-all-btn']" }],
    "detectPopup": [{ "visible": "[data-testid='privacy-banner']" }],
    "optIn": [],
    "optOut": [
        {
            "if": { "visible": "[data-testid='privacy-banner-decline-all-btn-desktop']" },
            "then": [
                {
                    "waitForThenClick": "[data-testid='privacy-banner-decline-all-btn-desktop']",
                    "retry": 10,
                    "retryInterval": 1000,
                    "comment": "Decline"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "[data-testid='privacy-banner-decline-all-btn-mobile']",
                    "retry": 10,
                    "retryInterval": 1000,
                    "comment": "Decline"
                }
            ]
        }
    ],
    "test": [{ "waitForVisible": "[data-testid='privacy-banner']", "timeout": 2000, "check": "none" }]
}
