{
    "name": "auto_NO_beducated.com_jjt",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://beducated.com/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?beducated\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "[x-data='consentBanner'] button[\\@click*='rejectAll']" }],
    "detectPopup": [{ "visible": "[x-data='consentBanner']" }],
    "optIn": [{ "waitForThenClick": "[x-data='consentBanner'] button[\\@click*='acceptAll']" }],
    "optOut": [
        { "waitForThenClick": "[x-data='consentBanner'] button[\\@click*='expanded = true']", "comment": "Manage preferences" },
        { "waitForThenClick": "[x-data='consentBanner'] button[\\@click*='rejectAll']", "comment": "Reject all" }
    ],
    "test": [{ "waitForVisible": "[x-data='consentBanner']", "timeout": 2000, "check": "none" }]
}
