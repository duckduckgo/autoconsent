{
    "name": "auto_NO_hacksmith.store_49t",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://hacksmith.store/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?hacksmith\\.store/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "cookie-bar [data-action='decline-policy']" }],
    "detectPopup": [{ "visible": "cookie-bar:not([hidden]) [data-action='decline-policy']" }],
    "optIn": [{ "waitForThenClick": "cookie-bar [data-action='accept-policy']" }],
    "optOut": [{ "waitForThenClick": "cookie-bar [data-action='decline-policy']", "comment": "Decline" }],
    "test": [{ "waitForVisible": "cookie-bar:not([hidden])", "timeout": 2000, "check": "none" }]
}
