{
    "name": "auto_FR_edumoov.com_sij",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://www.edumoov.com/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?edumoov\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "#cookie-message #close-cookie-message" }],
    "detectPopup": [{ "visible": "#cookie-message #close-cookie-message" }],
    "optIn": [],
    "optOut": [
        {
            "waitForThenClick": "#cookie-message #close-cookie-message",
            "retry": 10,
            "retryInterval": 1000,
            "comment": "Fermer: the 'refuser ce cookie' link only opens the legal page"
        }
    ],
    "test": [{ "waitForVisible": "#cookie-message", "timeout": 2000, "check": "none" }]
}
