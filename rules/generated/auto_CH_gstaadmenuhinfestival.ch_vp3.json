{
    "name": "auto_CH_gstaadmenuhinfestival.ch_vp3",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://www.gstaadmenuhinfestival.ch/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?(gstaadmenuhinfestival|menuhin)\\.ch/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "#cb-cookie-warning #cb-cookie-warning__button--decline" }],
    "detectPopup": [{ "visible": "#cb-cookie-warning #cb-cookie-warning__button--decline" }],
    "optIn": [{ "waitForThenClick": "#cb-cookie-warning #cb-cookie-warning__button--accept" }],
    "optOut": [{ "waitForThenClick": "#cb-cookie-warning #cb-cookie-warning__button--decline", "comment": "DECLINE" }],
    "test": [{ "waitForVisible": "#cb-cookie-warning", "timeout": 2000, "check": "none" }]
}
