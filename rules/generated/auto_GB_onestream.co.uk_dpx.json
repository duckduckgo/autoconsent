{
    "name": "auto_GB_onestream.co.uk_dpx",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://onestream.co.uk/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?onestream\\.co\\.uk/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "#cookies-policy form.cookies__customize" }],
    "detectPopup": [{ "visible": "#cookies-policy .cookies__btn--customize" }],
    "optIn": [{ "waitForThenClick": "#cookies-policy form[data-cookie-action='accept.all'] button" }],
    "optOut": [
        { "waitForThenClick": "#cookies-policy .cookies__btn--customize", "comment": "Customize" },
        { "waitForVisible": "#cookies-policy form.cookies__customize .cookiesBtn__link" },
        {
            "click": "#cookies-policy form.cookies__customize input[type='checkbox']:checked:not([value='essentials'])",
            "all": true,
            "optional": true
        },
        {
            "waitForThenClick": "#cookies-policy form.cookies__customize .cookiesBtn__link",
            "retry": 10,
            "retryInterval": 1000,
            "comment": "Save settings"
        },
        { "waitForVisible": "#cookies-policy", "check": "none", "timeout": 5000 }
    ],
    "test": [{ "waitForVisible": "#cookies-policy", "timeout": 2000, "check": "none" }]
}
