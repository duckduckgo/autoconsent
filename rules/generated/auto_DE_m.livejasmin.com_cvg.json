{
    "name": "auto_DE_m.livejasmin.com_cvg",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "https://m.livejasmin.com/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.|m\\.)?livejasmin\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "#consent_modal .over-18__manage-cookies-link, #legalAgreementModal [data-test-id='manage-cookies']" }],
    "detectPopup": [
        {
            "visible": "#consent_modal .over-18__manage-cookies-link, #legalAgreementModal.open [data-test-id='manage-cookies']",
            "check": "any"
        }
    ],
    "optIn": [],
    "optOut": [
        {
            "if": { "exists": "#consent_modal .over-18__manage-cookies-link" },
            "then": [
                {
                    "waitForThenClick": "#consent_modal .over-18__manage-cookies-link",
                    "retry": 10,
                    "retryInterval": 1000,
                    "comment": "Manage or reject Cookies"
                },
                { "waitForVisible": "[data-testid='PrivacyPreferenceCenterWithConsentCookieContent']" },
                {
                    "click": "[data-testid='PrivacyPreferenceCenterWithConsentCookieContent'] input[data-testid='PrivacyPreferenceCenterWithConsentCookieSwitch']:checked",
                    "all": true,
                    "optional": true
                },
                {
                    "waitForThenClick": "xpath/(//*[@data-testid='PrivacyPreferenceCenterWithConsentCookieContent']//button[@data-testid='ButtonStyledButton'])[last()]",
                    "comment": "Confirm My Choices"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "#legalAgreementModal [data-test-id='manage-cookies']",
                    "retry": 10,
                    "retryInterval": 1000,
                    "comment": "Manage or reject Cookies"
                },
                { "waitForVisible": "#ManageCookies [data-test-id='confirm-my-choices']", "timeout": 10000 },
                { "click": "#ManageCookies input[type='checkbox']:checked:not([disabled])", "all": true, "optional": true },
                { "waitForThenClick": "#ManageCookies [data-test-id='confirm-my-choices']", "comment": "Confirm My Choices" }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": "[data-testid='PrivacyPreferenceCenterWithConsentCookieContent'], #legalAgreementModal.open, #ManageCookies [data-test-id='confirm-my-choices']",
            "timeout": 2000,
            "check": "none"
        }
    ]
}
