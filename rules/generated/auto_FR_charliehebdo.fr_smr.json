{
    "name": "auto_FR_charliehebdo.fr_smr",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "http://charliehebdo.fr/"
    },
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?charliehebdo\\.fr/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "#cookie-banner #cookie-see-more" }],
    "detectPopup": [{ "visible": "#cookie-banner .cookie-banner.visible #cookie-see-more" }],
    "optIn": [{ "waitForThenClick": "#cookie-banner .accept-cookies" }],
    "optOut": [
        { "waitForThenClick": "#cookie-banner #cookie-see-more", "comment": "AFFICHER PLUS DE CHOIX" },
        {
            "any": [
                { "waitForVisible": "#cookie-choices-modal .reject-cookies", "timeout": 2000 },
                { "click": "#cookie-banner #cookie-see-more" }
            ],
            "comment": "the first click can land before the handler is attached"
        },
        { "waitForVisible": "#cookie-choices-modal .reject-cookies" },
        { "click": "#cookie-choices-modal .reject-cookies", "comment": "REFUSER TOUS LES COOKIES" }
    ],
    "test": [{ "waitForVisible": "#cookie-banner .cookie-banner.visible", "timeout": 2000, "check": "none" }]
}
