{
    "name": "finsweet",
    "vendorUrl": "https://finsweet.com/components/cookie-consent",
    "cosmetic": false,
    "prehideSelectors": ["[fs-consent-element=banner]"],
    "detectCmp": [
        {
            "any": [{ "exists": "[fs-consent-element=banner]" }, { "exists": ["[fs-consent-element=root]", "[fs-consent-element=banner]"] }]
        }
    ],
    "detectPopup": [
        {
            "any": [
                { "visible": "[fs-consent-element=banner] [fs-consent-element=allow]" },
                { "visible": ["[fs-consent-element=root]", "[fs-consent-element=banner] [fs-consent-element=allow]"] }
            ]
        }
    ],
    "optIn": [
        { "wait": 500 },
        {
            "if": { "exists": "[fs-consent-element=banner] [fs-consent-element=allow]" },
            "then": [{ "waitForThenClick": "[fs-consent-element=banner] [fs-consent-element=allow]" }],
            "else": [{ "waitForThenClick": ["[fs-consent-element=root]", "[fs-consent-element=banner] [fs-consent-element=allow]"] }]
        }
    ],
    "optOut": [
        { "wait": 500 },
        {
            "if": { "exists": "[fs-consent-element=banner] [fs-consent-element=deny]" },
            "then": [{ "click": "[fs-consent-element=banner] [fs-consent-element=deny]" }],
            "else": [
                {
                    "if": { "exists": ["[fs-consent-element=root]", "[fs-consent-element=banner] [fs-consent-element=deny]"] },
                    "then": [{ "click": ["[fs-consent-element=root]", "[fs-consent-element=banner] [fs-consent-element=deny]"] }],
                    "else": [{ "hide": "[fs-consent-element=banner], [fs-consent-element=root]" }]
                }
            ]
        }
    ]
}
