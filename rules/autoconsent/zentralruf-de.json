{
    "name": "zentralruf-de",
    "runContext": {
        "urlPattern": "^https://(www\\.)?zentralruf\\.de"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "#gdvdl-cookie-consent-dialog-content-button-auswahl-button" }],
    "detectPopup": [{ "visible": "#gdvdl-cookie-consent-dialog-content-button-auswahl-button" }],
    "optIn": [
        {
            "waitForThenClick": "#gdvdl-cookie-consent-dialog-content-button-alle-button"
        }
    ],
    "optOut": [
        {
            "click": "#gdvdl-cookie-consent-dialog-tracking-cookies-checkbox-checkbox-input:checked",
            "optional": true
        },
        { "waitForThenClick": "#gdvdl-cookie-consent-dialog-content-button-auswahl-button", "comment": "Auswahl speichern" }
    ],
    "test": [
        {
            "waitForVisible": "#gdvdl-cookie-consent-dialog-content-button-auswahl-button",
            "check": "none",
            "timeout": 2000
        }
    ]
}
