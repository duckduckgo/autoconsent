{
    "name": "bswhealth",
    "vendorUrl": "https://www.bswhealth.com/",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?bswhealth\\.com/"
    },
    "cosmetic": false,
    "prehideSelectors": [".consent-banner"],
    "detectCmp": [
        {
            "exists": ".consent-banner .manage-cookies-btn"
        }
    ],
    "detectPopup": [
        {
            "visible": ".consent-banner .manage-cookies-btn"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".consent-banner .accept-btn"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".consent-banner .manage-cookies-btn"
        },
        {
            "waitForVisible": ".config-banner .config-banner_section"
        },
        {
            "waitForThenClick": ".config-banner input[type=checkbox]:checked:not(:disabled)",
            "all": true,
            "optional": true
        },
        {
            "waitForThenClick": ".config-banner .accept-btn"
        }
    ],
    "test": [
        {
            "cookieContains": "x-bsw-consentCookie"
        }
    ]
}
