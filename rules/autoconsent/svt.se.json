{
    "name": "svt.se",
    "vendorUrl": "https://www.svt.se/",
    "runContext": {
        "urlPattern": "^https://(\\w+\\.)?svt\\.se/"
    },
    "prehideSelectors": [".CookieConsent__root"],
    "detectCmp": [
        {
            "exists": ".CookieConsent__root"
        }
    ],
    "detectPopup": [
        {
            "visible": ".CookieConsent__root .CookieConsent__modal"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".CookieConsent__root button[data-consent-action=accept-all], #CookieConsent_accept_all"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".CookieConsent__root button[data-consent-action=reject-all], #CookieConsent_reject_all"
        }
    ],
    "test": [
        {
            "cookieContains": "\"improved_experience\":false,\"partners\":false"
        }
    ]
}
