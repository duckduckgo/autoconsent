{
    "name": "make-community",
    "prehideSelectors": ["#cookie-footer"],
    "detectCmp": [{ "visible": "#cookie-footer" }, { "exists": "#cookie-footer #cookie-analytics-only" }],
    "detectPopup": [{ "visible": "#cookie-footer" }],
    "optIn": [{ "waitForThenClick": "#cookie-accept" }],
    "optOut": [
        { "waitForThenClick": "#cookie-configure" },
        { "waitForVisible": "#cookie-dialog" },
        { "if": { "exists": "#cookie-dialog #analyticsCookies:checked" }, "then": [{ "click": "#cookie-dialog #analyticsCookies" }] },
        {
            "if": { "exists": "#cookie-dialog #nonNeccessaryCookies:checked" },
            "then": [{ "click": "#cookie-dialog #nonNeccessaryCookies" }]
        },
        { "waitForThenClick": ".ui-dialog:has(#cookie-dialog) .ui-dialog-titlebar-close" }
    ],
    "test": [{ "cookieContains": "cookielawinfo-checkbox-non-necessary=no" }]
}
