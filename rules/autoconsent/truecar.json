{
    "name": "truecar",
    "vendorUrl": "https://www.truecar.com/",
    "cosmetic": true,
    "runContext": {
        "urlPattern": "^https://(www\\.)?truecar\\.com/"
    },
    "prehideSelectors": [".fixed.bottom-0:has(#cookie-banner-heading)"],
    "detectCmp": [
        {
            "exists": ".fixed.bottom-0 [aria-labelledby=cookie-banner-heading]"
        }
    ],
    "detectPopup": [
        {
            "visible": ".fixed.bottom-0 [aria-labelledby=cookie-banner-heading]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[aria-labelledby=cookie-banner-heading] button"
        }
    ],
    "optOut": [
        {
            "hide": ".fixed.bottom-0:has(#cookie-banner-heading)"
        }
    ]
}
