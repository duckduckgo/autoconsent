{
    "name": "xhamster-us",
    "cosmetic": true,
    "prehideSelectors": ["[data-role=\"cookies-modal\"] [class*=cookiesAnnounce]"],
    "detectCmp": [{ "exists": "[data-role=\"cookies-modal\"] [class*=cookiesAnnounce]" }],
    "detectPopup": [{ "visible": "[data-role=\"cookies-modal\"] [class*=cookiesAnnounce] [class*=announceText]" }],
    "optIn": [{ "click": "[data-role=\"cookies-modal\"] [class*=cookiesAnnounce] button[class*=closeButton]" }],
    "optOut": [{ "hide": "[data-role=\"cookies-modal\"] [class*=cookiesAnnounce]" }]
}
