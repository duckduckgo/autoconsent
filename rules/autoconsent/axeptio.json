{
    "name": "axeptio",
    "prehideSelectors": [".axeptio_widget,.axeptio_mount"],
    "detectCmp": [
        {
            "exists": ".axeptio_widget,.axeptio_mount"
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "exists": ".axeptio-widget--open"
                },
                {
                    "visible": ".axeptio_mount .axeptio_widget"
                },
                {
                    "visible": [".axeptio_mount .needsclick", ".axeptio_widget"]
                }
            ]
        }
    ],
    "optIn": [
        {
            "if": { "exists": ".axeptio_mount .needsclick" },
            "then": [{ "click": [".axeptio_mount .needsclick", "button#axeptio_btn_acceptAll,button#axeptio_btn_acceptAllAndNext"] }],
            "else": [{ "click": "button#axeptio_btn_acceptAll,button#axeptio_btn_acceptAllAndNext" }]
        }
    ],
    "optOut": [
        {
            "if": { "exists": ".axeptio_mount .needsclick" },
            "then": [
                {
                    "waitForVisible": [
                        ".axeptio_mount .needsclick",
                        "button#axeptio_btn_dismiss,button.ax-discardButton,button#axeptio_btn_close"
                    ]
                },
                { "wait": 300 },
                {
                    "click": [".axeptio_mount .needsclick", "button#axeptio_btn_dismiss,button.ax-discardButton,button#axeptio_btn_close"]
                }
            ],
            "else": [
                { "waitForVisible": "button#axeptio_btn_dismiss,button.ax-discardButton,button#axeptio_btn_close" },
                { "wait": 300 },
                { "click": "button#axeptio_btn_dismiss,button.ax-discardButton,button#axeptio_btn_close" }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "axeptio_authorized_vendors=%2C%2C"
        }
    ]
}
