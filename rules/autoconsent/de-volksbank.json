{
    "name": "de-volksbank",
    "prehideSelectors": [],
    "detectCmp": [
        {
            "any": [
                { "exists": "#cookieconsent.cookie-overlay .cookie-buttons #cookie-deny" },
                { "exists": "ap-cookie-consent [data-bb=decline] button" }
            ]
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "exists": "#cookieconsent.cookie-overlay[style*=\"visibility: visible\"] #cookie-deny"
                },
                { "visible": "ap-cookie-consent [data-bb=decline] button" }
            ]
        }
    ],
    "optIn": [
        {
            "if": { "exists": "ap-cookie-consent [data-bb=accept] button" },
            "then": [{ "waitForThenClick": "ap-cookie-consent [data-bb=accept] button" }],
            "else": [{ "waitForThenClick": "#cookieconsent.cookie-overlay #cookie-accept" }]
        }
    ],
    "optOut": [
        {
            "if": { "exists": "ap-cookie-consent [data-bb=decline] button" },
            "then": [{ "waitForThenClick": "ap-cookie-consent [data-bb=decline] button" }],
            "else": [{ "waitForThenClick": "#cookieconsent.cookie-overlay #cookie-deny" }]
        }
    ],
    "test": [{ "cookieContains": "CLC_GDPR=AB%3A" }]
}
