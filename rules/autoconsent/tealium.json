{
    "name": "Tealium",
    "prehideSelectors": ["#__tealiumGDPRecModal,#__tealiumGDPRcpPrefs,#__tealiumImplicitmodal,#consent-layer"],
    "detectCmp": [{ "exists": "#__tealiumGDPRecModal *,#__tealiumGDPRcpPrefs *,#__tealiumImplicitmodal *" }, { "eval": "EVAL_TEALIUM_0" }],
    "detectPopup": [
        { "visible": "#__tealiumGDPRecModal *,#__tealiumGDPRcpPrefs *,#__tealiumImplicitmodal *", "check": "any" },
        {
            "any": [
                { "eval": "EVAL_TEALIUM_NO_DECISION" },
                {
                    "visible": "#__tealiumGDPRecModal #decline_cookies,#__tealiumGDPRecModal #gpc_button,#__tealiumGDPRcpPrefs .js-cookie-consent .js-btn-reject-all"
                }
            ]
        }
    ],
    "optOut": [
        { "eval": "EVAL_TEALIUM_1" },
        { "eval": "EVAL_TEALIUM_DONOTSELL" },
        {
            "if": {
                "exists": "#__tealiumGDPRecModal #rejectAll,#__tealiumGDPRecModal #decline_cookies,#__tealiumGDPRecModal #gpc_button,#__tealiumGDPRcpPrefs #preferences_prompt_reject_all_submit,#__tealiumGDPRcpPrefs .js-cookie-consent .js-btn-reject-all"
            },
            "then": [
                {
                    "waitForThenClick": "#__tealiumGDPRecModal #rejectAll,#__tealiumGDPRecModal #decline_cookies,#__tealiumGDPRecModal #gpc_button,#__tealiumGDPRcpPrefs #preferences_prompt_reject_all_submit,#__tealiumGDPRcpPrefs .js-cookie-consent .js-btn-reject-all"
                }
            ],
            "else": [
                { "hide": "#__tealiumGDPRecModal,#__tealiumGDPRcpPrefs,#__tealiumImplicitmodal" },
                {
                    "waitForThenClick": "#cm-acceptNone,.js-accept-essential-cookies,#continueWithoutAccepting,#no_consent,#consent_prompt_decline,#teal-decline-consent,#deny_full_submit_1",
                    "timeout": 1000,
                    "optional": true
                }
            ]
        }
    ],
    "optIn": [{ "hide": "#__tealiumGDPRecModal,#__tealiumGDPRcpPrefs" }, { "eval": "EVAL_TEALIUM_2" }],
    "test": [
        { "eval": "EVAL_TEALIUM_3" },
        { "eval": "EVAL_TEALIUM_DONOTSELL_CHECK" },
        { "visible": "#__tealiumGDPRecModal,#__tealiumGDPRcpPrefs > *", "check": "none" }
    ]
}
