{
    "name": "facebook",
    "runContext": {
        "urlPattern": "^https://(www\\.)?facebook\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "[role=\"dialog\"]:has(a[href*=\"/policies/cookies/\"]) div[aria-hidden=\"true\"] + div[role=\"button\"][tabindex=\"0\"]"
        }
    ],
    "detectPopup": [
        {
            "visible": "[role=\"dialog\"]:has(a[href*=\"/policies/cookies/\"]) div[aria-hidden=\"true\"] + div[role=\"button\"][tabindex=\"0\"]"
        }
    ],
    "optIn": [
        {
            "wait": 500
        },
        {
            "waitForThenClick": "[role=\"dialog\"]:has(a[href*=\"/policies/cookies/\"]) div[role=\"button\"][tabindex=\"0\"]:has(+ div[aria-hidden=\"true\"])",
            "retry": 3,
            "retryInterval": 500
        },
        {
            "waitForVisible": "[role=\"dialog\"]:has(a[href*=\"/policies/cookies/\"])",
            "check": "none"
        }
    ],
    "optOut": [
        {
            "wait": 500
        },
        {
            "waitForThenClick": "[role=\"dialog\"]:has(a[href*=\"/policies/cookies/\"]) div[aria-hidden=\"true\"] + div[role=\"button\"][tabindex=\"0\"]",
            "retry": 3,
            "retryInterval": 500
        },
        {
            "waitForVisible": "[role=\"dialog\"]:has(a[href*=\"/policies/cookies/\"])",
            "check": "none"
        }
    ]
}
