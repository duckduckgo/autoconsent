{
    "name": "ndl-go-jp",
    "vendorUrl": "https://www.ndl.go.jp/",
    "runContext": {
        "urlPattern": "^https://([a-z0-9-]+\\.)?ndl\\.go\\.jp/"
    },
    "prehideSelectors": [".privacy-confirmation"],
    "detectCmp": [
        {
            "exists": ".privacy-confirmation .pc-buttons"
        }
    ],
    "detectPopup": [
        {
            "visible": ".privacy-confirmation .pc-buttons"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".privacy-confirmation [data-cy=privacy-accept-all], .privacy-confirmation [data-cy=accept-all-button]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".privacy-confirmation [data-cy=accept-core-button], .privacy-confirmation .pc-buttons > button.ui-parts-button-fill:not([data-cy])"
        }
    ],
    "test": [
        {
            "waitForVisible": ".privacy-confirmation .pc-buttons",
            "timeout": 2000,
            "check": "none"
        }
    ]
}
