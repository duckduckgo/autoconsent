{
    "name": "okayama-kanko-jp",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?okayama-kanko\\.jp/"
    },
    "prehideSelectors": ["#cookiePolicy"],
    "detectCmp": [
        {
            "exists": "#cookiePolicy > menu"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookiePolicy"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookiePolicy > button"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookiePolicy > menu"
        },
        {
            "waitForVisible": "#cookiePolicy",
            "check": "none"
        }
    ]
}
