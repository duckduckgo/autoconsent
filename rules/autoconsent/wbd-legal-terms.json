{
    "name": "wbd-legal-terms",
    "vendorUrl": "https://www.wbd.com/",
    "comment": "Terms-and-cookies notice with only an Agree button. The <dialog> variant is modal, so hiding it with CSS leaves the page inert; close it without submitting the form instead. The MUI modal variant cannot be dismissed, so it is hidden; its scroll lock is overridden with a stylesheet because the site re-applies it inline on client-side navigation. Sweepstakes pages only load their entry form (ngxFrame embed) after Agree, so the rule skips them to keep the popup available.",
    "cosmetic": true,
    "minimumRuleStepVersion": 3,
    "detectCmp": [
        {
            "exists": "dialog#ltp-dialog, [id=\"id/ltp\"]"
        },
        {
            "exists": "iframe[id^=\"ngxFrame\"][data-src]",
            "negated": true
        }
    ],
    "detectPopup": [
        {
            "visible": "dialog#ltp-dialog[open], [id=\"id/ltp/banner\"]",
            "check": "any"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#ltp-submit-btn, [id=\"id/ltp/banner/button\"]"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "dialog#ltp-dialog"
            },
            "then": [
                {
                    "eval": "EVAL_WBD_LTP_CLOSE"
                },
                {
                    "removeClass": "is-NoScroll",
                    "selector": "body",
                    "optional": true
                }
            ],
            "else": [
                {
                    "hide": "[id=\"id/ltp\"]"
                },
                {
                    "stylesheet": "body:has([id=\"id/ltp\"]) { overflow: auto !important; }",
                    "stylesheetId": "wbd-legal-terms-scroll-unlock"
                }
            ]
        }
    ]
}
