{
    "name": "fod-fujitv",
    "vendorUrl": "https://fod.fujitv.co.jp/",
    "runContext": {
        "urlPattern": "^https?://fod\\.fujitv\\.co\\.jp/"
    },
    "prehideSelectors": [".cookieCheckContainer"],
