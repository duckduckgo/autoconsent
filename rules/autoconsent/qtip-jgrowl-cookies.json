        }
    ],
    "optIn": [
        {
            "waitForThenClick": "xpath///div[@id='qtip-growl-container']/div[contains(@class,'qtip-jgrowl')][.//div[contains(@class,'qtip-title')][contains(., 'ookie')]]//a[contains(@class,'qtip-close')]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "xpath///div[@id='qtip-growl-container']/div[contains(@class,'qtip-jgrowl')][.//div[contains(@class,'qtip-title')][contains(., 'ookie')]]//a[contains(@class,'qtip-close')]"
        }
    ],
    "test": [
        {
