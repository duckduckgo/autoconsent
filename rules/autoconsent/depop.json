{
    "name": "depop",
    "vendorUrl": "https://www.depop.com/",
    "cosmetic": true,
    "minimumRuleStepVersion": 2,
    "comment": "Transcend airgap ignores untrusted clicks, so the banner is hidden together with the site's own backdrop and body scroll lock.",
    "runContext": {
        "urlPattern": "^https://(www\\.)?depop\\.com/"
    },
    "prehideSelectors": ["#transcend-consent-manager", "#cookies-modal"],
    "detectCmp": [
        {
            "exists": "#transcend-consent-manager"
        }
    ],
    "detectPopup": [
        {
            "visible": ["#transcend-consent-manager", "#consentManagerMainDialog"]
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#transcend-consent-manager", "#consentManagerMainDialog .accept-or-reject-all-button-row button"]
        }
    ],
    "optOut": [
        {
            "hide": "#transcend-consent-manager"
        },
        {
            "hide": "#cookies-modal"
        },
        {
            "waitFor": "#cookies-modal",
            "timeout": 3000,
            "optional": true
        },
        {
            "addStyle": "overflow: auto !important",
            "selector": "body",
            "optional": true
        }
    ]
}
