{
    "name": "renaud-bray",
    "vendorUrl": "https://www.renaud-bray.com/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?renaud-bray\\.com/"
    },
    "prehideSelectors": ["#cookie-banner"],
    "detectCmp": [
        {
            "exists": "#cookie-consent-container[style*='visibility'] #cookie-banner"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-banner"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-banner .cookie-banner-agree-to-all-btn"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookie-banner .cookie-banner-preferences-btn"
        },
        {
            "waitForVisible": "#cookie-consent-detail"
        },
        {
            "waitForThenClick": "#cookie-consent-detail .modal-content-agree-to-preference-btn"
        }
    ],
    "test": [
        {
            "visible": "#cookie-banner",
            "check": "none"
        },
        {
            "visible": "#cookie-consent-detail",
            "check": "none"
        }
    ]
}
