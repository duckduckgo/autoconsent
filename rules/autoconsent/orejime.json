{
    "name": "orejime",
    "_metadata": {
        "vendorUrl": "https://orejime.empreintedigitale.fr/"
    },
    "prehideSelectors": [".orejime-Notice", ".orejime-Banner"],
    "detectCmp": [
        {
            "exists": ".orejime-Notice-declineButton, .orejime-Banner-declineButton, .orejime-Modal .orejime-PurposeToggles-disableAll, .orejime-Modal .orejime-AppToggles-disableAll"
        }
    ],
    "detectPopup": [
        {
            "visible": ".orejime-Notice, .orejime-Banner, .orejime-Modal .orejime-PurposeToggles-disableAll, .orejime-Modal .orejime-AppToggles-disableAll"
        }
    ],
    "optIn": [
        {
            "if": {
                "visible": ".orejime-Notice-saveButton, .orejime-Banner-saveButton"
            },
            "then": [
                {
                    "waitForThenClick": ".orejime-Notice-saveButton, .orejime-Banner-saveButton"
                }
            ],
            "else": [
                {
                    "waitForThenClick": ".orejime-Modal .orejime-PurposeToggles-enableAll, .orejime-Modal .orejime-AppToggles-enableAll"
                },
                {
                    "waitForThenClick": ".orejime-Modal-saveButton"
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": ".orejime-Notice-declineButton, .orejime-Banner-declineButton"
            },
            "then": [
                {
                    "waitForThenClick": ".orejime-Notice-declineButton, .orejime-Banner-declineButton"
                }
            ],
            "else": [
                {
                    "waitForThenClick": ".orejime-Modal .orejime-PurposeToggles-disableAll, .orejime-Modal .orejime-AppToggles-disableAll"
                },
                {
                    "waitForThenClick": ".orejime-Modal-saveButton"
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": ".orejime-Notice, .orejime-Banner, .orejime-Modal",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
