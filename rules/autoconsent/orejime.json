{
    "name": "orejime",
    "_metadata": { "vendorUrl": "https://orejime.empreintedigitale.fr/" },
    "prehideSelectors": [".orejime-NoticePortal", ".orejime-Banner"],
    "detectCmp": [{ "exists": ".orejime-Notice, .orejime-Banner" }],
    "detectPopup": [{ "visible": ".orejime-Notice-declineButton, .orejime-Banner-declineButton", "check": "any" }],
    "optIn": [{ "waitForThenClick": ".orejime-Notice-saveButton, .orejime-Banner-saveButton" }],
    "optOut": [{ "waitForThenClick": ".orejime-Notice-declineButton, .orejime-Banner-declineButton" }],
    "test": [
        {
            "waitForVisible": ".orejime-Notice, .orejime-Banner",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
