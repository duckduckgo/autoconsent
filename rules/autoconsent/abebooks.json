{
    "name": "abebooks",
    "vendorUrl": "https://www.abebooks.com/",
    "prehideSelectors": ["#abe-gdpr-banner #gdpr-banner-component"],
    "detectCmp": [{ "exists": "#abe-gdpr-banner #gdpr-banner-component-decline-btn" }],
    "detectPopup": [{ "visible": "#gdpr-banner-component" }],
    "optIn": [{ "waitForThenClick": "#gdpr-banner-component-consent-btn" }],
    "optOut": [
        { "waitForThenClick": "#gdpr-banner-component-decline-btn" },
        { "waitForVisible": "#gdpr-banner-component", "check": "none", "timeout": 2000, "optional": true }
    ],
    "test": [{ "cookieContains": "abeconsent=%221%3A1%2C2%3A0%2C3%3A0%2C4%3A0%22" }]
}
