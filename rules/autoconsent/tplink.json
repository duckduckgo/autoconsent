{
    "name": "tplink",
    "vendorUrl": "https://www.tp-link.com",
    "cosmetic": false,
    "prehideSelectors": [".tp-dialog.cookie-dialog", ".tp-cookie-banner"],
    "detectCmp": [
        {
            "exists": ".tp-dialog.cookie-dialog, :not(.tp-cookie-banner-tpl) > .tp-cookie-banner .show-cookie-dialog, #tp-cookie-banner > .tp-cookie-banner + .el-dialog__wrapper"
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "visible": ".tp-dialog.cookie-dialog button"
                },
                {
                    "visible": ":not(.tp-cookie-banner-tpl) > .tp-cookie-banner .show-cookie-dialog"
                },
                {
                    "visible": "#tp-cookie-banner > .tp-cookie-banner .tp-cookie-button-box"
                }
            ]
        }
    ],
    "optIn": [
        {
            "if": {
                "visible": ":not(.tp-cookie-banner-tpl) > .tp-cookie-banner .tp-cookie-accept-all"
            },
            "then": [
                {
                    "click": ":not(.tp-cookie-banner-tpl) > .tp-cookie-banner .tp-cookie-accept-all"
                }
            ],
            "else": [
                {
                    "if": {
                        "exists": "#tp-cookie-banner > .el-dialog__wrapper"
                    },
                    "then": [
                        {
                            "waitForThenClick": "#tp-cookie-banner > .tp-cookie-banner .tp-cookie-button-box .el-button--primary"
                        }
                    ],
                    "else": [
                        {
                            "waitForThenClick": ".tp-dialog-box .tp-cookie-accept-all"
                        }
                    ]
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": ":not(.tp-cookie-banner-tpl) > .tp-cookie-banner .show-cookie-dialog"
            },
            "then": [
                {
                    "click": ":not(.tp-cookie-banner-tpl) > .tp-cookie-banner .show-cookie-dialog"
                }
            ]
        },
        {
            "if": {
                "visible": "#tp-cookie-banner > .tp-cookie-banner .tp-cookie-button-box .el-button--default"
            },
            "then": [
                {
                    "click": "#tp-cookie-banner > .tp-cookie-banner .tp-cookie-button-box .el-button--default"
                }
            ]
        },
        {
            "if": {
                "exists": "#tp-cookie-banner > .el-dialog__wrapper"
            },
            "then": [
                {
                    "waitForVisible": "#tp-cookie-banner > .el-dialog__wrapper .el-dialog__footer"
                },
                {
                    "waitForThenClick": "#tp-cookie-banner > .el-dialog__wrapper .el-dialog__footer button.is-plain:first-child"
                }
            ],
            "else": [
                {
                    "waitForVisible": ".tp-dialog.cookie-dialog .tp-dialog-box"
                },
                {
                    "if": {
                        "exists": ".tp-dialog-box .tp-cookie-opt-out"
                    },
                    "then": [
                        {
                            "waitForThenClick": ".tp-dialog-box .tp-cookie-opt-out"
                        }
                    ],
                    "else": [
                        {
                            "click": ".tp-dialog-box .checkbox.clickable.checked",
                            "all": true,
                            "optional": true
                        },
                        {
                            "waitForThenClick": ".tp-dialog-box .tp-cookie-save"
                        }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "_privacy_base=1"
        },
        {
            "negated": true,
            "cookieContains": "_privacy_marketing=1"
        }
    ]
}
