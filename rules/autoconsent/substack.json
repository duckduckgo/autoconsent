{
    "name": "substack",
    "_metadata": {
        "vendorUrl": "https://substack.com/"
    },
    "cosmetic": false,
    "runContext": {
        "main": true
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "div[class*=cookieBanner].pencraft"
        }
    ],
    "detectPopup": [
        {
            "visible": "div[class*=cookieBanner].pencraft"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "div[class*=cookieBanner].pencraft button:last-of-type"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "div[class*=cookieBanner].pencraft button:nth-of-type(2):nth-last-of-type(2)"
        }
    ],
    "test": [
        {
            "cookieContains": "hideCookieBanner="
        }
    ]
}
