{
    "name": "toyota",
    "vendorUrl": "https://www.toyota.com/",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": ["#cookie-banner.visible"],
    "detectCmp": [
        {
            "exists": "#cookie-banner.visible [data-cookie-preferences-button]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-banner.visible [data-cookie-preferences-button]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-banner.visible [data-cookie-preferences-button]"
        },
        {
            "waitForVisible": "#ensModalWrapper[open] #ensSave"
        },
        {
            "if": {
                "exists": "#FunctionalCookiesSlide:not(:checked)"
            },
            "then": [
                {
                    "click": "label[for=FunctionalCookiesSlide]"
                }
            ]
        },
        {
            "if": {
                "exists": "#TargetingCookiesSlide:not(:checked)"
            },
            "then": [
                {
                    "click": "label[for=TargetingCookiesSlide]"
                }
            ]
        },
        {
            "waitForThenClick": "#ensSave"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookie-banner.visible [data-cookie-preferences-button]"
        },
        {
            "waitForVisible": "#ensModalWrapper[open] #ensSave"
        },
        {
            "if": {
                "exists": "#FunctionalCookiesSlide:checked"
            },
            "then": [
                {
                    "click": "label[for=FunctionalCookiesSlide]"
                }
            ]
        },
        {
            "if": {
                "exists": "#TargetingCookiesSlide:checked"
            },
            "then": [
                {
                    "click": "label[for=TargetingCookiesSlide]"
                }
            ]
        },
        {
            "waitForThenClick": "#ensSave"
        }
    ],
    "test": [
        {
            "wait": 500
        },
        {
            "cookieContains": "TOYOTANATIONAL_ENSIGHTEN_PRIVACY_TargetingCookies=0"
        }
    ]
}
