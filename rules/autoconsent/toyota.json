{
    "name": "toyota",
    "vendorUrl": "https://www.toyota.com/",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": ["#cookie-banner.visible"],
    "detectCmp": [
        {
            "exists": "#cookie-banner.visible .cookie-banner__container [data-cookie-preferences-button]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-banner.visible .cookie-banner__container [data-cookie-preferences-button]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-banner.visible .cookie-banner__dismiss"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookie-banner.visible .cookie-banner__container [data-cookie-preferences-button]"
        },
        {
            "waitForVisible": "#ensModalWrapper[style*=block] #ensSave",
            "timeout": 5000
        },
        {
            "click": "#ensModalWrapper .ensCheckbox:checked:not(:disabled):not(#EssentialCookiesSlide)",
            "all": true,
            "optional": true
        },
        {
            "waitForThenClick": "#ensModalWrapper #ensSave"
        }
    ],
    "test": [
        {
            "wait": 1000
        },
        {
            "cookieContains": "_ENSIGHTEN_PRIVACY_TargetingCookies=0"
        }
    ]
}
