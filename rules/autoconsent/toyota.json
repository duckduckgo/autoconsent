{
    "name": "toyota",
    "vendorUrl": "https://www.toyota.com/",
    "cosmetic": false,
    "minimumRuleStepVersion": 2,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": ["#cookie-banner.visible"],
    "detectCmp": [
        {
            "exists": "#cookie-banner.visible .cookie-banner__container [data-cookie-preferences-button]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-banner.visible .cookie-banner__container [data-cookie-preferences-button]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-banner.visible .cookie-banner__dismiss"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookie-banner.visible [data-cookie-preferences-button]"
        },
        {
            "waitForVisible": "#ensModalWrapper[style*=block]",
            "timeout": 5000
        },
        {
            "click": "#ensModalWrapper .ensCheckbox:checked:not(:disabled):not([id*=Essential])",
            "all": true
        },
        {
            "waitForThenClick": "#ensSave"
        },
        {
            "if": { "exists": "body[style*=\"overflow: hidden\"]" },
            "then": [
                {
                    "addStyle": "overflow: visible",
                    "selector": "body",
                    "optional": true
                }
            ]
        }
    ],
    "test": [
        {
            "wait": 1000
        },
        {
            "cookieContains": "_ENSIGHTEN_PRIVACY_TargetingCookies=0"
        }
    ]
}
