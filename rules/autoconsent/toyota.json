{
    "name": "toyota",
    "vendorUrl": "https://www.toyota.com/",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": ["#cookie-banner.visible"],
    "detectCmp": [
        {
            "exists": "#cookie-banner .cookie-banner__primary-content [data-cookie-preferences-button]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-banner.visible .cookie-banner__primary-content [data-cookie-preferences-button]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-banner.visible .cookie-banner__dismiss"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookie-banner.visible .cookie-banner__primary-content [data-cookie-preferences-button]"
        },
        {
            "waitForVisible": "#ensModalWrapper .ensModal",
            "timeout": 5000
        },
        {
            "click": "#ensModalWrapper .ensCheckbox:checked:not(:disabled):not(#EssentialCookiesSlide)",
            "all": true,
            "optional": true
        },
        {
            "waitForThenClick": "#ensModalWrapper #ensSave"
        }
    ],
    "test": [
        {
            "cookieContains": "TOYOTANATIONAL_ENSIGHTEN_PRIVACY_TargetingCookies=0"
        }
    ]
}
