{
    "name": "toyota",
    "vendorUrl": "https://www.toyota.com/",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": ["#cookie-banner.visible"],
    "detectCmp": [
        {
            "exists": "#cookie-banner .cookie-banner__container [data-cookie-preferences-button]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-banner.visible .cookie-banner__container"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-banner.visible .cookie-banner__dismiss"
        }
    ],
    "optOut": [
        {
            "waitFor": "#ensModalWrapper",
            "timeout": 5000
        },
        {
            "waitForThenClick": "#cookie-banner.visible [data-cookie-preferences-button]"
        },
        {
            "waitForVisible": "#ensModalWrapper #ensSave"
        },
        {
            "if": { "exists": "#consentModalOverlay" },
            "then": [
                {
                    "waitFor": "#ensModalWrapper[tabindex]",
                    "timeout": 2000,
                    "optional": true
                }
            ]
        },
        {
            "click": "#ensModalWrapper .ensCheckbox:checked:not(:disabled):not(#EssentialCookiesSlide)",
            "all": true,
            "optional": true
        },
        {
            "waitForThenClick": "#ensModalWrapper #ensSave"
        }
    ],
    "test": [
        {
            "cookieContains": "ENSIGHTEN_PRIVACY_TargetingCookies=0"
        }
    ]
}
