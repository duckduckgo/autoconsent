{
    "name": "bestsecret",
    "vendorUrl": "https://www.bestsecret.com/",
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?bestsecret\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "#cmp-deny-all"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cmp-deny-all"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cmp-accept-all"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cmp-deny-all",
            "comment": "ABLEHNEN"
        }
    ],
    "test": [
        {
            "waitForVisible": "#cmp-deny-all",
            "timeout": 2000,
            "check": "none"
        }
    ]
}
