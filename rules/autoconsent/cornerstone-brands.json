{
    "name": "cornerstone-brands",
    "vendorUrl": "https://www.garnethill.com/",
    "prehideSelectors": [
        ".c-cookie-banner.c-custom-sheet",
        ".c-tray .c-cookie-banner",
        "[id^=\"monetate_selectorHTML\"] > .gdprCookieBanner"
    ],
    "detectCmp": [
        {
            "any": [
                { "exists": ":is(.c-cookie-banner.c-custom-sheet, .c-tray .c-cookie-banner) .c-cookie-banner__close-button" },
                { "exists": "[id^=\"monetate_selectorHTML\"] > .gdprCookieBanner .gdprCookieBannerCloseBtn" }
            ]
        }
    ],
    "detectPopup": [
        {
            "any": [
                { "visible": ".c-cookie-banner.c-custom-sheet, .c-tray .c-cookie-banner" },
                { "visible": "[id^=\"monetate_selectorHTML\"] > .gdprCookieBanner" }
            ]
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ":is(.c-cookie-banner.c-custom-sheet, .c-tray .c-cookie-banner) .c-cookie-banner__close-button",
            "timeout": 5000,
            "optional": true
        },
        {
            "comment": "notice-only banner shown in GDPR regions, may be injected after the main banner",
            "waitForThenClick": "[id^=\"monetate_selectorHTML\"] > .gdprCookieBanner .gdprCookieBannerCloseBtn",
            "timeout": 6000,
            "optional": true
        },
        {
            "comment": "the GDPR banner can also appear outside the monetate wrapper, without a close button we can rely on",
            "hide": ".gdprCookieBanner",
            "optional": true
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ":is(.c-cookie-banner.c-custom-sheet, .c-tray .c-cookie-banner) .c-cookie-banner__close-button",
            "timeout": 5000,
            "optional": true
        },
        {
            "comment": "notice-only banner shown in GDPR regions, may be injected after the main banner",
            "waitForThenClick": "[id^=\"monetate_selectorHTML\"] > .gdprCookieBanner .gdprCookieBannerCloseBtn",
            "timeout": 6000,
            "optional": true
        },
        {
            "comment": "the GDPR banner can also appear outside the monetate wrapper, without a close button we can rely on",
            "hide": ".gdprCookieBanner",
            "optional": true
        }
    ],
    "test": [
        {
            "waitForVisible": ".c-cookie-banner.c-custom-sheet, .c-tray .c-cookie-banner, [id^=\"monetate_selectorHTML\"] > .gdprCookieBanner",
            "check": "none",
            "timeout": 2000
        }
    ]
}
