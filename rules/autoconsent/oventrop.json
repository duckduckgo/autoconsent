{
    "name": "oventrop",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?oventrop\\.com/"
    },
    "prehideSelectors": ["#ConsentModalControl_divModal"],
    "detectCmp": [{ "exists": "#ConsentModalControl_divModal" }],
    "detectPopup": [{ "visible": "#ConsentModalControl_divModal #ConsentModalControl_lbtnSaveSelection" }],
    "optIn": [{ "waitForThenClick": "#ConsentModalControl_lbtnAcceptAll" }],
    "optOut": [
        {
            "click": "#ConsentModalControl_divModal .toggle:not(.off):not([disabled])",
            "all": true,
            "optional": true
        },
        { "waitForThenClick": "#ConsentModalControl_lbtnSaveSelection" }
    ]
}
