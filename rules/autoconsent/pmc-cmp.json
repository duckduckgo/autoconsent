{
    "name": "pmc",
    "cosmetic": true,
    "prehideSelectors": ["#pmc-pp-tou--notice", "aside[aria-labelledby=\"pmc-privacy-banner-heading\"]"],
    "detectCmp": [
        { "exists": "#pmc-pp-tou--notice, aside[aria-labelledby=\"pmc-privacy-banner-heading\"]" },
        { "exists": "#onetrust-consent-sdk" }
    ],
    "detectPopup": [{ "visible": "#pmc-pp-tou--notice, aside[aria-labelledby=\"pmc-privacy-banner-heading\"]" }],
    "optIn": [{ "click": "span.pmc-pp-tou--notice-close-btn, aside[aria-labelledby=\"pmc-privacy-banner-heading\"] button" }],
    "optOut": [{ "hide": "#pmc-pp-tou--notice, aside[aria-labelledby=\"pmc-privacy-banner-heading\"]" }]
}
