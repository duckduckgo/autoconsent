{
    "name": "healthysupplies",
    "vendorUrl": "https://www.healthysupplies.co.uk/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?healthysupplies\\.co\\.uk/"
    },
    "prehideSelectors": ["#cookie_popup"],
    "detectCmp": [{ "exists": "#cookie_popup .cookie_buttons" }],
    "detectPopup": [{ "visible": "#cookie_popup .cookie_buttons" }],
    "optIn": [{ "waitForThenClick": "#cookie_popup button[onclick*='cookie_popup_allow']" }],
    "optOut": [
        { "waitForThenClick": "#cookie_popup a[onclick*='cookie_popup_settings']" },
        { "waitForVisible": "#cookie_popup .cookie_settings" },
        { "click": "#cookie_popup .cookie_content_div input[type=checkbox]:checked", "all": true, "optional": true },
        { "waitForThenClick": "#cookie_popup button[onclick*='cookie_settings_update']", "retry": 5, "retryInterval": 500 }
    ],
    "test": [{ "wait": 1000 }, { "cookieContains": "cookieok_ad_storage=no" }]
}
