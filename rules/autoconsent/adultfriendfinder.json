{
    "name": "adultfriendfinder",
    "vendorUrl": "https://adultfriendfinder.com/www/guest/#/",
    "runContext": {
        "urlPattern": "^https://(www\\.)?adultfriendfinder\\.com/"
    },
    "prehideSelectors": [".fullpageCover", "[data-cookie-banner]"],
    "detectCmp": [
        {
            "exists": ".fullpageCover a[href*='/go/page/privacy.html'], [data-cookie-banner] button"
        }
    ],
    "detectPopup": [
        {
            "visible": ".fullpageCover a[href*='/go/page/privacy.html'], [data-cookie-banner] button",
            "check": "any"
        }
    ],
    "optIn": [
        {
            "if": { "exists": ".fullpageCover a[href*='/go/page/privacy.html']" },
            "then": [{ "waitForThenClick": ".fullpageCover div.rounded-full:nth-child(1)" }],
            "else": [{ "waitForThenClick": "[data-cookie-banner] button.rd-btn-primary" }]
        }
    ],
    "optOut": [
        {
            "if": { "exists": ".fullpageCover a[href*='/go/page/privacy.html']" },
            "then": [{ "waitForThenClick": ".fullpageCover div.rounded-full:nth-child(2)" }],
            "else": [{ "waitForThenClick": "[data-cookie-banner] button:not(.rd-btn-primary):first-of-type" }]
        }
    ],
    "test": [
        {
            "eval": "EVAL_ADULTFRIENDFINDER_TEST"
        }
    ]
}
