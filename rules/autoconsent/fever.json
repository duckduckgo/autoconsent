{
    "name": "fever",
    "prehideSelectors": ["astro-island[component-url*=\"CookiesBanner\"] .cookies", "#cookie-advice.fv-cookie-advice"],
    "detectCmp": [
        {
            "any": [
                {
                    "exists": "astro-island[component-url*=\"CookiesBanner\"] .cookies button.cookies__buttons--settings"
                },
                {
                    "exists": "#cookie-advice.fv-cookie-advice [data-testid=\"accept-cookies-button\"]"
                }
            ]
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "visible": "astro-island[component-url*=\"CookiesBanner\"] .cookies"
                },
                {
                    "visible": "#cookie-advice.fv-cookie-advice"
                }
            ]
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": "astro-island[component-url*=\"CookiesBanner\"] .cookies"
            },
            "then": [
                {
                    "waitForThenClick": "astro-island[component-url*=\"CookiesBanner\"] .cookies button.cookies__buttons--accept"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "#cookie-advice.fv-cookie-advice [data-testid=\"accept-cookies-button\"]"
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "astro-island[component-url*=\"CookiesBanner\"] .cookies"
            },
            "then": [
                {
                    "waitForThenClick": "astro-island[component-url*=\"CookiesBanner\"] .cookies button.cookies__buttons--settings"
                },
                {
                    "if": {
                        "exists": "astro-island[component-url*=\"CookiesBanner\"] .cookies input[name=\"targeting\"]:checked"
                    },
                    "then": [
                        {
                            "click": "astro-island[component-url*=\"CookiesBanner\"] .cookies input[name=\"targeting\"]"
                        }
                    ]
                },
                {
                    "waitForThenClick": "astro-island[component-url*=\"CookiesBanner\"] .cookies button.cookies__buttons--accept"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "#cookie-advice.fv-cookie-advice .fv-cookie-advice__message button"
                },
                {
                    "waitForThenClick": ".modal-footer--cookies-management button"
                },
                {
                    "waitForVisible": "#cookie-advice.fv-cookie-advice",
                    "check": "none",
                    "timeout": 3000
                }
            ]
        }
    ],
    "test": [
        {
            "any": [
                {
                    "cookieContains": "cookiesPreferences=[%22necessary%22]"
                },
                {
                    "cookieContains": "fv_consent_targeting=false"
                }
            ]
        }
    ]
}
