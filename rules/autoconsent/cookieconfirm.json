{
    "name": "cookieconfirm",
    "vendorUrl": "https://www.cookieconfirm.com/",
    "prehideSelectors": ["#cc-consent-banner"],
    "detectCmp": [{ "exists": "#cc-consent-banner" }],
    "detectPopup": [{ "visible": "#cc-consent-banner .cc-b" }],
    "optIn": [{ "waitForThenClick": "#cc-consent-banner #cc-accept-all" }],
    "optOut": [
        {
            "if": { "exists": "#cc-consent-banner #cc-reject-all" },
            "then": [{ "waitForThenClick": "#cc-consent-banner #cc-reject-all" }],
            "else": [
                {
                    "if": { "visible": "#cc-consent-banner #cc-customize-selection" },
                    "then": [
                        { "click": "#cc-consent-banner #cc-customize-selection" },
                        { "waitForVisible": "#cc-consent-banner #cc-allow-selection" }
                    ]
                },
                {
                    "click": "#cc-consent-banner .cc-toggle[aria-checked='true']:has(input[value='analytical'])",
                    "optional": true
                },
                {
                    "click": "#cc-consent-banner .cc-toggle[aria-checked='true']:has(input[value='marketing'])",
                    "optional": true
                },
                { "waitForThenClick": "#cc-consent-banner #cc-allow-selection" }
            ]
        }
    ],
    "test": [{ "cookieContains": "CC_p_accepted_cookies=[\"functional\"]" }]
}
