{
    "name": "cookieconfirm",
    "vendorUrl": "https://cookieconfirm.com/",
    "prehideSelectors": ["#cc-consent-banner"],
    "detectCmp": [{ "exists": "#cc-consent-banner[data-tab-opened] .cc-banner-footer" }],
    "detectPopup": [{ "visible": "#cc-consent-banner .cc-banner-footer" }],
    "optIn": [{ "waitForThenClick": "#cc-consent-banner #cc-accept-all" }],
    "optOut": [
        {
            "if": { "exists": "#cc-consent-banner #cc-reject-all" },
            "then": [{ "click": "#cc-consent-banner #cc-reject-all" }],
            "else": [
                {
                    "if": { "visible": "#cc-consent-banner #cc-customize-selection" },
                    "then": [
                        { "click": "#cc-consent-banner #cc-customize-selection" },
                        { "waitForVisible": "#cc-consent-banner #cc-allow-selection", "timeout": 2000 }
                    ]
                },
                {
                    "if": { "exists": "#cc-consent-banner .cc-toggle[aria-checked=\"true\"]:has(input[value=\"analytical\"])" },
                    "then": [{ "click": "#cc-consent-banner .cc-toggle[aria-checked=\"true\"]:has(input[value=\"analytical\"])" }]
                },
                {
                    "if": { "exists": "#cc-consent-banner .cc-toggle[aria-checked=\"true\"]:has(input[value=\"marketing\"])" },
                    "then": [{ "click": "#cc-consent-banner .cc-toggle[aria-checked=\"true\"]:has(input[value=\"marketing\"])" }]
                },
                { "waitForThenClick": "#cc-consent-banner #cc-allow-selection" }
            ]
        }
    ],
    "test": [{ "wait": 500 }, { "cookieContains": "CC_p_accepted_cookies=[\"functional\"]" }]
}
