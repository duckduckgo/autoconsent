{
    "name": "worldshopping",
    "vendorUrl": "https://www.worldshopping.global/",
    "cosmetic": false,
    "prehideSelectors": [],
    "detectCmp": [{ "exists": ["#zigzag-worldshopping-checkout", "#zigzag-test__cookie-banner-settings"] }],
    "detectPopup": [{ "visible": ["#zigzag-worldshopping-checkout", "#zigzag-test__cookie-banner-settings"] }],
    "optIn": [{ "waitForThenClick": ["#zigzag-worldshopping-checkout", "#zigzag-test__cookie-banner-accept-all"] }],
    "optOut": [
        { "waitForThenClick": ["#zigzag-worldshopping-checkout", "#zigzag-test__cookie-banner-settings"] },
        { "waitForVisible": ["#zigzag-worldshopping-checkout", "#zigzag-test__cookie-settings-save"] },
        { "click": ["#zigzag-worldshopping-checkout", "input[type=checkbox]:checked"], "all": true, "optional": true },
        { "waitForThenClick": ["#zigzag-worldshopping-checkout", "#zigzag-test__cookie-settings-save"] }
    ],
    "test": [{ "eval": "EVAL_WORLDSHOPPING_TEST" }]
}
