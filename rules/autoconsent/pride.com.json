{
    "name": "pride.com",
    "vendorUrl": "https://unknown",
    "cosmetic": true,
    "prehideSelectors": [".gdpr-wrapper"],
    "detectCmp": [
        {
            "exists": ".gdpr-wrapper .gdpr-cookie-wrapper"
        }
    ],
    "detectPopup": [
        {
            "visible": ".gdpr-wrapper .gdpr-cookie-wrapper"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".gdpr-wrapper .gdpr-cookie-accept"
        }
    ],
    "optOut": [
        {
            "hide": ".gdpr-wrapper"
        },
        {
            "waitForThenClick": ".fc-consent-root .fc-cta-do-not-consent",
            "timeout": 8000,
            "retry": 2,
            "retryInterval": 1000,
            "optional": true,
            "comment": "in the EU, a Funding Choices dialog follows the notice a few seconds later"
        }
    ]
}
