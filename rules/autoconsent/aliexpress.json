{
    "name": "aliexpress",
    "vendorUrl": "https://aliexpress.com/",
    "runContext": {
        "urlPattern": "^https://([a-z]*\\.)?aliexpress\\.com/"
    },
    "prehideSelectors": ["#gdpr-new-container", "#voyager-gdpr-2025"],
    "detectCmp": [
        {
            "exists": "#gdpr-new-container,#voyager-gdpr > div,#voyager-gdpr-2025 > div > div > button"
        }
    ],
    "detectPopup": [
        {
            "visible": "#gdpr-new-container,#voyager-gdpr > div,#voyager-gdpr-2025 > div > div > button",
            "check": "any"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#gdpr-new-container button:last-of-type,#voyager-gdpr > div > div > button:nth-child(1),#voyager-gdpr-2025 > div > div > button:first-child"
        }
    ],
    "optOut": [
        {
            "if": { "exists": "#voyager-gdpr > div" },
            "then": [
                {
                    "waitForThenClick": "#voyager-gdpr > div > div > button:nth-child(2)"
                }
            ],
            "else": [
                {
                    "if": { "exists": "#gdpr-new-container" },
                    "then": [
                        {
                            "if": { "exists": "#gdpr-new-container button:nth-of-type(3)" },
                            "then": [
                                {
                                    "waitForThenClick": "#gdpr-new-container button:nth-of-type(2)"
                                }
                            ],
                            "else": [
                                {
                                    "waitForThenClick": "#gdpr-new-container button:first-of-type"
                                },
                                {
                                    "waitForVisible": "#voyager-gdpr-2025",
                                    "timeout": 5000
                                },
                                {
                                    "waitForThenClick": "#voyager-gdpr-2025 button:last-of-type"
                                }
                            ]
                        }
                    ],
                    "else": [
                        {
                            "if": { "exists": "#voyager-gdpr-2025 > div > div > button:nth-child(3)" },
                            "then": [
                                {
                                    "waitForThenClick": "#voyager-gdpr-2025 > div > div > button:nth-child(2)"
                                }
                            ],
                            "else": [
                                {
                                    "waitForThenClick": "#voyager-gdpr-2025 > div > div > button:last-child"
                                },
                                {
                                    "waitForVisible": "#voyager-gdpr-2025 > div > div > div > button:last-child",
                                    "timeout": 5000
                                },
                                {
                                    "waitForThenClick": "#voyager-gdpr-2025 > div > div > div > button:last-child"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
