{
    "name": "nordnet",
    "vendorUrl": "https://www.nordnet.dk/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?nordnet\\.(dk|se|no|fi)/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "[role=dialog] #cookie-accept-all-secondary"
        }
    ],
    "detectPopup": [
        {
            "visible": "[role=dialog] #cookie-accept-all-secondary"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[role=dialog] #cookie-accept-all-secondary"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "[role=dialog] #cookie-accept-all-secondary + button"
        }
    ],
    "test": [
        {
            "cookieContains": "consent_cookie=necessary"
        }
    ]
}
