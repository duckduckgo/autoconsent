{
    "name": "teacherspensions.co.uk",
    "vendorUrl": "https://www.teacherspensions.co.uk/",
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?teacherspensions\\.co\\.uk/"
    },
    "prehideSelectors": ["#cookie-choice-info"],
    "detectCmp": [
        {
            "exists": "#cookie-choice-info a.cookie_button[onclick*='showPopup']"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-choice-info"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookie-choice-info a.cookie_button[onclick*='closePopup']"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookie-choice-info a.cookie_button[onclick*='showPopup']"
        },
        {
            "waitForVisible": "#cookie-banner input[name='ctl-btn-confirm-choices']"
        },
        {
            "click": "#cookie-banner input[type=checkbox]:checked",
            "all": true,
            "optional": true
        },
        {
            "click": "#cookie-banner input[name='ctl-btn-confirm-choices']"
        }
    ],
    "test": [
        {
            "cookieContains": "analyticsCookieConsent=n"
        }
    ]
}
