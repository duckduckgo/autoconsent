{
    "name": "paypal.com",
    "prehideSelectors": ["#gdprCookieBanner"],
    "detectCmp": [{ "exists": "#gdprCookieBanner" }],
    "detectPopup": [{ "visible": "#gdprCookieContent_wrapper" }],
    "optIn": [{ "click": "#acceptAllButton" }],
    "optOut": [
        {
            "comment": "The banner renders before its click handler is attached, and early clicks are ignored.",
            "waitForThenClick": "#bannerDeclineButton",
            "retry": 10,
            "retryInterval": 500
        }
    ],
    "test": [{ "wait": 500 }, { "cookieContains": "type%3Dexplicit" }]
}
