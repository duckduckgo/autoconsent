{
    "name": "widiba",
    "vendorUrl": "https://www.widiba.it/",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?widiba\\.it/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": ["#iframe_bol_pb", ".wd-cookie-banner"] }],
    "detectPopup": [{ "visible": ["#iframe_bol_pb", ".wd-cookie-banner.x-cookie-open"] }],
    "optIn": [
        { "waitForThenClick": ["#iframe_bol_pb", ".wd-cookie-banner.x-cookie-open .wd-cookie-banner__buttons > a.wd-button:first-child"] }
    ],
    "optOut": [{ "waitForThenClick": ["#iframe_bol_pb", ".wd-cookie-banner.x-cookie-open .wd-cookie-banner__header__close"] }],
    "test": [{ "waitForVisible": ["#iframe_bol_pb", ".wd-cookie-banner.x-cookie-open"], "check": "none", "timeout": 2000 }]
}
