{
    "name": "bytom.com.pl",
    "vendorUrl": "https://bytom.com.pl/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?bytom\\.com\\.pl/"
    },
    "prehideSelectors": ["#bottom-cookies"],
    "detectCmp": [{ "exists": "#bottom-cookies #openCookiesSettings" }],
    "detectPopup": [{ "visible": "#bottom-cookies" }],
    "optIn": [{ "waitForThenClick": "#acceptAllCookiesBottom" }],
    "optOut": [
        { "waitForThenClick": "#openCookiesSettings" },
        { "waitForVisible": "#cookiesModal #cookiesForm", "timeout": 5000 },
        { "click": "#cookiesForm input[type=checkbox]:checked", "all": true, "optional": true },
        { "waitForThenClick": "#cookiesModal #saveSelectedCookies", "retry": 3, "retryInterval": 1000 }
    ],
    "test": [{ "waitForVisible": "#bottom-cookies, #cookiesModal", "check": "none", "timeout": 3000 }]
}
