{
    "name": "cookie-law-info-legacy",
    "cosmetic": true,
    "prehideSelectors": ["#cookie-law-info-bar"],
    "detectCmp": [
        { "exists": "#cookie-law-info-bar .cli-plugin-main-button:not([data-cli_action])" },
        { "eval": "EVAL_COOKIE_LAW_INFO_LEGACY_DETECT" }
    ],
    "detectPopup": [{ "visible": "#cookie-law-info-bar" }],
    "optIn": [{ "click": "#cookie-law-info-bar .cli-plugin-main-button" }],
    "optOut": [{ "hide": "#cookie-law-info-bar" }]
}
