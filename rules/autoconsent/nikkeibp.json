{
    "name": "nikkeibp",
    "vendorUrl": "https://www.nikkeibp.co.jp/",
    "prehideSelectors": [".bpPrivacy"],
    "detectCmp": [{ "exists": ".bpPrivacy .bpPrivacy_button-close" }],
