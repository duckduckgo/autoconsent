{
    "name": "WP DSGVO Tools",
    "vendorUrl": "https://wordpress.org/plugins/shapepress-dsgvo/",
    "prehideSelectors": [".sp-dsgvo"],
    "detectCmp": [{ "exists": ".sp-dsgvo.sp-dsgvo-popup-overlay" }],
    "detectPopup": [{ "visible": ".sp-dsgvo.sp-dsgvo-popup-overlay", "check": "any" }],
    "optIn": [{ "waitForThenClick": ".sp-dsgvo-privacy-btn-accept-all", "all": true }],
    "optOut": [
        {
            "if": { "exists": ".sp-dsgvo-popup-overlay .sp-dsgvo-privacy-btn-accept-nothing" },
            "then": [{ "waitForThenClick": ".sp-dsgvo-popup-overlay .sp-dsgvo-privacy-btn-accept-nothing" }],
            "else": [{ "waitForThenClick": ".sp-dsgvo-popup-overlay .sp-dsgvo-popup-close" }]
        }
    ],
    "test": [{ "cookieContains": "integrations%22%3A%5B%5D" }]
}
