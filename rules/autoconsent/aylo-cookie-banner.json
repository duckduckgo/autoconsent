{
    "name": "aylo-cookie-banner",
    "_metadata": {
        "vendorUrl": "https://www.redtube.com/"
    },
    "prehideSelectors": ["#cookie_consent_wrapper, #cookie_consent_min_wrapper, #manage_cookie_consent_modal"],
    "detectCmp": [
        {
            "exists": "#cookie_consent_wrapper:not(.hideConsent)"
        },
        {
            "exists": "#cookie_consent_wrapper #consent_accept_essential, #manage_cookie_consent_modal #modal_consent_accept_essential"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie_consent_wrapper:not(.hideConsent)"
        },
        {
            "visible": "#age_disclaimer_window,#ageDisclaimerWrapper",
            "check": "none"
        },
        {
            "eval": "EVAL_AYLO_COOKIE_MANAGER_READY"
        }
    ],
    "optIn": [
        {
            "if": {
                "visible": "#cookie_consent_wrapper #consent_accept_all"
            },
            "then": [
                {
                    "waitForThenClick": "#cookie_consent_wrapper #consent_accept_all"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "#manage_cookie_consent_modal #modal_consent_accept_all"
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": "#cookie_consent_wrapper #consent_accept_essential"
            },
            "then": [
                {
                    "waitForThenClick": "#cookie_consent_wrapper #consent_accept_essential"
                }
            ],
            "else": [
                {
                    "if": {
                        "visible": "#cookie_consent_wrapper #js_cookieBannerCloseBtn"
                    },
                    "then": [
                        {
                            "waitForThenClick": "#cookie_consent_wrapper #js_cookieBannerCloseBtn"
                        }
                    ],
                    "else": [
                        {
                            "waitForThenClick": "#manage_cookie_consent_modal #modal_consent_accept_essential"
                        }
                    ]
                }
            ]
        },
        {
            "waitForThenClick": "#cookie_consent_min_wrapper #close_minimized_banner",
            "comment": "dismiss the 'Some features may not be available...' minimized banner that may appear after opting out",
            "optional": true
        }
    ],
    "test": [
        {
            "any": [
                {
                    "cookieContains": "cookieConsent=1"
                },
                {
                    "cookieContains": "cookieConsent=5"
                }
            ]
        }
    ]
}
