{
    "name": "vortex-consent",
    "prehideSelectors": [".consent-overlay", "div.consent[role=dialog]"],
    "detectCmp": [
        {
            "exists": "div.consent[role=dialog] .consent-main-buttons .consent-decline-all"
        }
    ],
    "detectPopup": [
        {
            "visible": "div.consent[role=dialog] .consent-main-buttons .consent-decline-all"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "div.consent[role=dialog] .consent-main-buttons .consent-accept-all"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "div.consent[role=dialog] .consent-main-buttons .consent-decline-all"
        }
    ],
    "test": [
        {
            "cookieContains": "PrivacyPolicyOptOut"
        },
        {
            "cookieContains": "UsageAnalysisConsent=yes",
            "negated": true
        }
    ]
}
