{
    "name": "cookiecuttr",
    "vendorUrl": "https://github.com/cdwharton/cookieCuttr",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [".cc-cookies"],
    "detectCmp": [
        {
            "exists": ".cc-cookies .cc-cookie-accept"
        }
    ],
    "detectPopup": [
        {
            "visible": ".cc-cookies .cc-cookie-accept",
            "check": "any",
            "comment": "some integrations render a second, hidden .cc-cookies bar for the declined state"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".cc-cookies .cc-cookie-accept"
        }
    ],
    "optOut": [
        {
            "if": { "exists": ".cc-cookies .cc-cookie-decline" },
            "then": [
                {
                    "click": ".cc-cookies .cc-cookie-decline"
                }
            ],
            "else": [
                {
                    "hide": ".cc-cookies"
                }
            ]
        },
        {
            "click": "#cookies_declinedbar .js-pp-cookie-hide-decline",
            "optional": true,
            "comment": "dismisses the follow-up bar that some integrations show once cookies are declined"
        }
    ]
}
