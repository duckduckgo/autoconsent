{
    "name": "cookiecuttr",
    "vendorUrl": "https://github.com/cdwharton/cookieCuttr",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [".cc-cookies"],
    "detectCmp": [
        {
            "exists": ".cc-cookies .cc-cookie-accept"
        }
    ],
    "detectPopup": [
        {
            "visible": ".cc-cookies:not(#cookies_declinedbar) .cc-cookie-accept",
            "check": "any"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".cc-cookies:not(#cookies_declinedbar) .cc-cookie-accept"
        }
    ],
    "optOut": [
        {
            "if": { "exists": ".cc-cookies .cc-cookie-decline" },
            "then": [
                {
                    "click": ".cc-cookies .cc-cookie-decline"
                }
            ],
            "else": [
                {
                    "hide": ".cc-cookies"
                }
            ]
        }
    ]
}
