{
    "name": "ynjn",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?ynjn\\.jp/"
    },
    "prehideSelectors": ["article:has(a[href*='shueisha.co.jp/privacy'])"],
    "detectCmp": [
        {
            "exists": "article:has(a[href*='shueisha.co.jp/privacy'])"
        }
    ],
    "detectPopup": [
        {
            "visible": "article:has(a[href*='shueisha.co.jp/privacy']) > div"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "article:has(a[href*='shueisha.co.jp/privacy']) > div > div:last-child"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "article:has(a[href*='shueisha.co.jp/privacy']) > div > div:last-child"
        }
    ],
    "test": [
        {
            "waitForVisible": "article:has(a[href*='shueisha.co.jp/privacy']) > div",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
