{
    "name": "efilli",
    "vendorUrl": "https://efilli.com/",
    "cosmetic": false,
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": ["efilli-layout-dynamic", "[efl-consent-not-saved]"]
        }
    ],
    "detectPopup": [
        {
            "visible": ["efilli-layout-dynamic", "[efl-consent-not-saved][data-name]"],
            "check": "any"
        }
    ],
    "optIn": [
        {
            "eval": "EVAL_EFILLI_ACCEPT"
        }
    ],
    "optOut": [
        {
            "eval": "EVAL_EFILLI_REJECT"
        },
        {
            "waitForVisible": ["efilli-layout-dynamic", "[efl-consent-not-saved][data-name]"],
            "check": "none",
            "timeout": 2000
        },
        {
            "waitForVisible": ["efilli-layout-dynamic", "[efl-consent-not-saved][data-name]"],
            "check": "any",
            "timeout": 1000,
            "optional": true
        },
        {
            "if": {
                "visible": ["efilli-layout-dynamic", "[efl-consent-not-saved][data-name]"],
                "check": "any"
            },
            "then": [
                {
                    "eval": "EVAL_EFILLI_REJECT"
                },
                {
                    "waitForVisible": ["efilli-layout-dynamic", "[efl-consent-not-saved][data-name]"],
                    "check": "none",
                    "timeout": 2000
                }
            ]
        }
    ],
    "test": [
        {
            "eval": "EVAL_EFILLI_TEST"
        }
    ]
}
