{
    "name": "efilli",
    "vendorUrl": "https://efilli.com/",
    "prehideSelectors": ["efilli-layout-dynamic"],
    "detectCmp": [{ "exists": "efilli-layout-dynamic" }],
    "detectPopup": [{ "visible": ["efilli-layout-dynamic", "[efl-consent-not-saved] [efl-consent-not-saved]"], "check": "any" }],
    "optOut": [
        { "eval": "EVAL_EFILLI_REJECT_ALL" },
        { "waitForVisible": ["efilli-layout-dynamic", "[efl-consent-not-saved] [efl-consent-not-saved]"], "check": "none", "timeout": 2000 }
    ],
    "optIn": [{ "eval": "EVAL_EFILLI_ACCEPT_ALL" }],
    "test": [{ "eval": "EVAL_EFILLI_TEST" }]
}
