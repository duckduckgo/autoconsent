{
    "name": "fullertonhotels.com",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "https://secureprivacy.ai/"
    },
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": ["#ifrmCookieBanner", "#sp-decline"]
        }
    ],
    "detectPopup": [
        {
            "visible": ["#ifrmCookieBanner", "#sp-accept, #sp-decline"],
            "check": "any"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#ifrmCookieBanner", "#sp-accept"]
        }
    ],
    "optOut": [
        {
            "wait": 500
        },
        {
            "waitFor": ["#ifrmCookieBanner", "#sp-decline"]
        },
        {
            "click": ["#ifrmCookieBanner", "#sp-decline"],
            "comment": "Decline is hidden in notice-only variants, but clicking it still records a rejection"
        }
    ],
    "test": []
}
