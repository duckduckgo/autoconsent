{
    "name": "fullertonhotels.com",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "https://secureprivacy.ai/"
    },
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": ["#ifrmCookieBanner", "#sp-decline, .evSpRejectBtn"]
        }
    ],
    "detectPopup": [
        {
            "any": [
                { "visible": ["#ifrmCookieBanner", "#sp-decline, .evSpRejectBtn"] },
                { "visible": ["#ifrmCookieBanner", "#sp-customize"] }
            ]
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#ifrmCookieBanner", "#sp-accept, .evSpAcceptBtn"]
        }
    ],
    "optOut": [
        {
            "wait": 500
        },
        {
            "if": { "visible": ["#ifrmCookieBanner", "#sp-decline, .evSpRejectBtn"] },
            "then": [
                {
                    "waitForThenClick": ["#ifrmCookieBanner", "#sp-decline, .evSpRejectBtn"],
                    "comment": "Decline"
                }
            ],
            "else": [
                {
                    "click": ["#ifrmCookieBanner", "#sp-customize"],
                    "comment": "Decline is hidden in some configs, use the preference center"
                },
                {
                    "waitForVisible": ["#ifrmPrivacyBanner", "button[data-sp-onclick*=saveSelected]"]
                },
                {
                    "if": { "visible": ["#ifrmPrivacyBanner", "button[data-sp-onclick*=declineAll]"] },
                    "then": [{ "click": ["#ifrmPrivacyBanner", "button[data-sp-onclick*=declineAll]"] }],
                    "else": [
                        {
                            "click": ["#ifrmPrivacyBanner", "input[data-tw-binding^='category:']:checked:not(:disabled)"],
                            "all": true,
                            "optional": true
                        },
                        {
                            "click": ["#ifrmPrivacyBanner", "button[data-sp-onclick*=saveSelected]"]
                        }
                    ]
                }
            ]
        }
    ],
    "test": []
}
