{
    "name": "anthropic",
    "vendorUrl": "https://claude.ai/",
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "[data-testid='consent-banner']:has(a[href='https://www.anthropic.com/legal/cookies'])"
        }
    ],
    "detectPopup": [
        {
            "visible": "[data-testid='consent-banner']:has(a[href='https://www.anthropic.com/legal/cookies'])"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[data-testid='consent-banner'] button[data-testid='consent-accept']"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "[data-testid='consent-banner'] button[data-testid='consent-reject']"
        }
    ],
    "test": [
        {
            "cookieContains": "anthropic-consent-preferences"
        }
    ]
}
