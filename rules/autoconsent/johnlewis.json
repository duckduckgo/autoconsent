{
    "name": "johnlewis.com",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?johnlewis\\.com/"
    },
    "prehideSelectors": ["div[class^=pecr-cookie-banner-]"],
    "detectCmp": [{ "exists": "div[class^=pecr-cookie-banner-]" }],
    "detectPopup": [{ "visible": "div[class^=pecr-cookie-banner-]" }],
    "optOut": [
        { "waitForThenClick": "div[class^=pecr-cookie-banner-] button[data-test=reject-all]", "retry": 3, "retryInterval": 500 },
        { "waitForVisible": "div[class^=pecr-cookie-banner-]", "check": "none", "timeout": 3000, "optional": true }
    ],
    "optIn": [{ "waitForThenClick": "div[class^=pecr-cookie-banner-] button[data-test=allow-all]" }],
    "test": [{ "cookieContains": "JOHNLEWIS_ENSIGHTEN_PRIVACY_Advertising=0" }]
}
