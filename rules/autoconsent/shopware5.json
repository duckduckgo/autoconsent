{
    "name": "shopware5",
    "_metadata": {
        "vendorUrl": "https://www.shopware.com/"
    },
    "prehideSelectors": [".page-wrap--cookie-permission[data-cookie-permission]:not(.spx-cookie-wrapper)"],
    "detectCmp": [
        {
            "comment": "the spx theme's variant is handled by shopware5-spx",
            "any": [
                {
                    "exists": ".page-wrap--cookie-permission[data-cookie-permission]:not(.spx-cookie-wrapper) .cookie-permission--decline-button"
                },
                {
                    "exists": ".page-wrap--cookie-permission[data-cookie-permission]:not(.spx-cookie-wrapper) .cookie-permission--configure-button[data-openconsentmanager]"
                }
            ]
        }
    ],
    "detectPopup": [
        {
            "comment": "some themes show the banner's content in a modal instead",
            "any": [
                {
                    "visible": ".page-wrap--cookie-permission[data-cookie-permission]"
                },
                {
                    "visible": ".js--modal.cookiePermissions"
                }
            ]
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": ".page-wrap--cookie-permission .cookie-permission--accept-button"
            },
            "then": [
                {
                    "waitForThenClick": ".page-wrap--cookie-permission .cookie-permission--accept-button"
                }
            ],
            "else": [
                {
                    "waitForThenClick": ".page-wrap--cookie-permission .cookie-permission--configure-button"
                },
                {
                    "waitForVisible": ".cookie-consent--save-button"
                },
                {
                    "click": ".cookie-consent--group-state-input:not(:checked):not([disabled])",
                    "all": true,
                    "optional": true
                },
                {
                    "click": ".cookie-consent--save-button"
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": ".page-wrap--cookie-permission .cookie-permission--decline-button"
            },
            "then": [
                {
                    "waitForThenClick": ".page-wrap--cookie-permission .cookie-permission--decline-button"
                }
            ],
            "else": [
                {
                    "comment": "non-essential groups are unchecked by default in the consent manager",
                    "waitForThenClick": ".js--modal.cookiePermissions .cookie-permission--configure-button, .page-wrap--cookie-permission:not(.is--hidden) .cookie-permission--configure-button"
                },
                {
                    "waitForThenClick": ".cookie-consent--save-button"
                },
                {
                    "comment": "some themes keep the consent manager open after saving",
                    "if": {
                        "visible": "#cookie-consent.is--open .cookie-consent--close"
                    },
                    "then": [
                        {
                            "click": "#cookie-consent.is--open .cookie-consent--close"
                        }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": ".page-wrap--cookie-permission[data-cookie-permission], .js--modal.cookiePermissions",
            "timeout": 2000,
            "check": "none"
        },
        {
            "any": [
                {
                    "cookieContains": "cookieDeclined=1"
                },
                {
                    "cookieContains": "\"active\":false"
                }
            ]
        }
    ]
}
