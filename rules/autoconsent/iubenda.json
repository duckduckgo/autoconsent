{
    "name": "iubenda",
    "prehideSelectors": ["#iubenda-cs-banner"],
    "detectCmp": [{ "exists": "#iubenda-cs-banner" }],
    "detectPopup": [{ "visible": ".iubenda-cs-accept-btn" }],
    "optIn": [{ "waitForThenClick": ".iubenda-cs-accept-btn" }],
    "optOut": [
        {
            "if": { "exists": ".iubenda-cs-reject-btn" },
            "then": [
                { "click": ".iubenda-cs-reject-btn" },
                { "waitForVisible": ".iubenda-cs-counter", "timeout": 500, "optional": true },
                {
                    "if": { "visible": ".iubenda-cs-counter" },
                    "then": [{ "click": ".iubenda-cs-reject-btn" }, { "wait": 300 }],
                    "optional": true
                },
                {
                    "if": { "visible": ".iubenda-cs-counter" },
                    "then": [{ "click": ".iubenda-cs-reject-btn" }],
                    "optional": true
                }
            ],
            "else": [
                {
                    "waitForThenClick": ".iubenda-cs-customize-btn"
                },
                {
                    "waitForThenClick": ".iub-btn-reject"
                },
                {
                    "waitForThenClick": "#iubFooterBtn"
                }
            ]
        }
    ],
    "test": [{ "eval": "EVAL_IUBENDA_1" }]
}
