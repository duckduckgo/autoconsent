{
    "name": "iubenda",
    "prehideSelectors": ["#iubenda-cs-banner"],
    "detectCmp": [{ "exists": "#iubenda-cs-banner" }],
    "detectPopup": [
        {
            "any": [{ "visible": ".iubenda-cs-accept-btn" }, { "visible": "#iubenda-cs-banner .iubenda-ccpa-opt-out" }]
        }
    ],
    "optIn": [{ "waitForThenClick": ".iubenda-cs-accept-btn" }],
    "optOut": [
        {
            "if": { "exists": ".iubenda-cs-reject-btn" },
            "then": [{ "click": ".iubenda-cs-reject-btn" }],
            "else": [
                {
                    "if": { "exists": ".iubenda-cs-customize-btn" },
                    "then": [
                        {
                            "waitForThenClick": ".iubenda-cs-customize-btn"
                        },
                        {
                            "waitForThenClick": ".iub-btn-reject"
                        },
                        {
                            "waitForThenClick": "#iubFooterBtn"
                        }
                    ],
                    "else": [
                        {
                            "if": { "exists": "#iubenda-cs-banner .iubenda-ccpa-opt-out" },
                            "then": [
                                {
                                    "click": "#iubenda-cs-banner .iubenda-ccpa-opt-out"
                                },
                                {
                                    "waitForThenClick": "#iubenda-alert .iubenda-button-confirm"
                                },
                                {
                                    "waitForThenClick": "#iubenda-cs-banner .iubenda-cs-close-btn",
                                    "timeout": 2000,
                                    "optional": true
                                }
                            ],
                            "else": [{ "hide": "#iubenda-cs-banner" }]
                        }
                    ]
                }
            ]
        }
    ],
    "test": [{ "any": [{ "eval": "EVAL_IUBENDA_1" }, { "cookieContains": "uspString%22%3A%221YY-" }] }]
}
