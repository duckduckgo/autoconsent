{
    "name": "iubenda",
    "prehideSelectors": ["#iubenda-cs-banner"],
    "detectCmp": [{ "exists": "#iubenda-cs-banner" }],
    "detectPopup": [{ "visible": ".iubenda-cs-accept-btn" }],
    "optIn": [{ "waitForThenClick": ".iubenda-cs-accept-btn" }],
    "optOut": [
        {
            "if": { "exists": ".iubenda-cs-reject-btn" },
            "comment": "When the banner content overflows, iubenda asks for a second press to confirm. `retry` covers that for a visible reject button; the guarded click below covers the variants where it is hidden and only reachable programmatically, so `retry` sees it as already gone.",
            "then": [
                { "waitForThenClick": ".iubenda-cs-reject-btn", "retry": 3, "retryInterval": 500 },
                { "waitForVisible": "#iubenda-cs-banner", "check": "none", "timeout": 1000, "optional": true },
                {
                    "if": { "visible": "#iubenda-cs-banner" },
                    "then": [{ "waitForThenClick": ".iubenda-cs-reject-btn", "timeout": 500, "optional": true }],
                    "optional": true
                }
            ],
            "else": [
                {
                    "waitForThenClick": ".iubenda-cs-customize-btn"
                },
                {
                    "waitForThenClick": ".iub-btn-reject"
                },
                {
                    "waitForThenClick": "#iubFooterBtn"
                }
            ]
        }
    ],
    "test": [{ "eval": "EVAL_IUBENDA_1" }]
}
