{
    "name": "stepstone-de",
    "vendorUrl": "https://www.stepstone.de/",
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https://(www\\.)?stepstone\\.de/"
    },
    "prehideSelectors": ["#GDPRConsentManagerContainer"],
    "detectCmp": [{ "exists": "#GDPRConsentManagerContainer [data-atx-component=\"cookieConsent\"]" }],
    "detectPopup": [{ "exists": "#explicit_consent" }],
    "optIn": [{ "waitForThenClick": "#ccmgt_explicit_accept" }],
    "optOut": [{ "waitForThenClick": "#ccmgt_explicit_preferences" }, { "waitForThenClick": "#ccmgt_preferences_reject" }],
    "test": [{ "cookieContains": "CONSENTMGR=c1:0%7Cc2:0" }]
}
