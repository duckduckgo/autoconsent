{
    "name": "mercadolibre",
    "vendorUrl": "https://www.mercadolibre.com/",
    "prehideSelectors": [".cookie-consent-banner-opt-out", ".cookie-consent-banner-opt-out__modal"],
    "detectCmp": [{ "exists": ".cookie-consent-banner-opt-out" }],
    "detectPopup": [{ "visible": ".cookie-consent-banner-opt-out" }],
    "optIn": [
        { "waitFor": ".cookie-consent-banner-opt-out__modal:defined", "timeout": 5000 },
        { "waitForThenClick": ".cookie-consent-banner-opt-out__action--key-accept", "retry": 2 }
    ],
    "optOut": [
        {
            "waitFor": ".cookie-consent-banner-opt-out__modal:defined",
            "timeout": 5000,
            "comment": "the banner script attaches its click handlers when it defines the modal element"
        },
        { "waitForThenClick": ".cookie-consent-banner-opt-out__action--key-customize", "retry": 2 },
        { "waitForVisible": ".cookie-consent-banner-opt-out__action--key-save", "timeout": 3000 },
        {
            "waitForVisible": ".cookie-consent-banner-opt-out__action--key-save",
            "check": "none",
            "timeout": 15000,
            "comment": "the mercadolibre-preferences frame rule saves the preferences, which closes the modal"
        }
    ],
    "test": [{ "cookieContains": "%22advertising%22%3Afalse" }]
}
