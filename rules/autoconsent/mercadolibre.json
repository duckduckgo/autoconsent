{
    "name": "mercadolibre",
    "prehideSelectors": [".cookie-consent-banner-opt-out"],
    "detectCmp": [
        {
            "exists": ".cookie-consent-banner-opt-out [data-testid=\"action:customize-button\"]"
        }
    ],
    "detectPopup": [
        {
            "visible": ".cookie-consent-banner-opt-out"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".cookie-consent-banner-opt-out [data-testid=\"action:understood-button\"]",
            "retry": 10,
            "retryInterval": 1000
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".cookie-consent-banner-opt-out [data-testid=\"action:customize-button\"]",
            "retry": 10,
            "retryInterval": 1000
        },
        {
            "waitForVisible": ".cookie-consent-banner-opt-out__action--key-save",
            "timeout": 15000
        },
        {
            "comment": "the mercadolibre-frame rule saves from inside the preferences iframe, which removes the modal",
            "waitForVisible": ".cookie-consent-banner-opt-out__action--key-save",
            "check": "none",
            "timeout": 30000
        }
    ],
    "test": [
        {
            "cookieContains": "%22advertising%22%3Afalse"
        },
        {
            "cookieContains": "%22traceability%22%3Afalse"
        }
    ]
}
