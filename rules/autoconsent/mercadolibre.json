{
    "name": "mercadolibre",
    "vendorUrl": "https://www.mercadolibre.com/",
    "cosmetic": false,
    "prehideSelectors": [".cookie-consent-banner-opt-out"],
    "detectCmp": [{ "exists": ".cookie-consent-banner-opt-out" }],
    "detectPopup": [{ "visible": ".cookie-consent-banner-opt-out" }],
    "optIn": [{ "waitForThenClick": ".cookie-consent-banner-opt-out__action--key-accept" }],
    "optOut": [
        { "waitForThenClick": ".cookie-consent-banner-opt-out__action--key-customize" },
        { "waitForVisible": ".cookie-consent-banner-opt-out__modal", "timeout": 5000 },
        { "waitForVisible": ".cookie-consent-banner-opt-out__modal", "check": "none", "timeout": 30000 }
    ],
    "test": [{ "cookieContains": "%22advertising%22%3Afalse" }, { "cookieContains": "%22traceability%22%3Afalse" }]
}
