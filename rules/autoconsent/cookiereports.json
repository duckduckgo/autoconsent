{
    "name": "cookiereports",
    "vendorUrl": "https://www.cookiereports.com/",
    "prehideSelectors": ["#CookieReportsPanel"],
    "detectCmp": [
        {
            "exists": "#CookieReportsPanel"
        }
    ],
    "detectPopup": [
        {
            "visible": "#CookieReportsBanner"
        }
    ],
    "optIn": [
        {
            "eval": "EVAL_COOKIEREPORTS_OPT_IN"
        },
        {
            "waitForVisible": "#CookieReportsBanner",
            "check": "none"
        }
    ],
    "optOut": [
        {
            "eval": "EVAL_COOKIEREPORTS_OPT_OUT"
        },
        {
            "waitForVisible": "#CookieReportsBanner",
            "check": "none"
        }
    ],
    "test": [
        {
            "eval": "EVAL_COOKIEREPORTS_TEST"
        }
    ]
}
