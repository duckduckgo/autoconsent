{
    "name": "cookiereports",
    "vendorUrl": "https://www.cookiereports.com/",
    "prehideSelectors": ["#CookieReportsBanner", "#CookieReportsOverlay"],
    "detectCmp": [
        {
            "exists": "#CookieReportsBanner"
        }
    ],
    "detectPopup": [
        {
            "visible": "#CookieReportsBanner"
        }
    ],
    "optIn": [
        {
            "eval": "EVAL_COOKIEREPORTS_OPT_IN"
        }
    ],
    "optOut": [
        {
            "eval": "EVAL_COOKIEREPORTS_OPT_OUT"
        }
    ],
    "test": [
        {
            "cookieContains": "=1=true&2=false&3=false&4=false&5=false"
        }
    ]
}
