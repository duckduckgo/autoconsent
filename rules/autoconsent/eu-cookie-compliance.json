{
    "name": "eu-cookie-compliance-banner",
    "vendorUrl": "https://www.drupal.org/project/eu_cookie_compliance",
    "detectCmp": [
        {
            "exists": "body.eu-cookie-compliance-popup-open #sliding-popup :is(.decline-button, .eu-cookie-compliance-reject-button, .accept-necessary, .eu-cookie-compliance-save-preferences-button)"
        }
    ],
    "detectPopup": [{ "exists": "body.eu-cookie-compliance-popup-open" }],
    "optIn": [{ "waitForThenClick": "#sliding-popup :is(.agree-button, .accept-all)" }],
    "optOut": [
        {
            "waitForThenClick": "#sliding-popup :is(.decline-button, .eu-cookie-compliance-reject-button, .accept-necessary, .eu-cookie-compliance-save-preferences-button)"
        }
    ],
    "test": [
        {
            "cookieContains": "cookie-agreed=2",
            "negated": true
        }
    ]
}
