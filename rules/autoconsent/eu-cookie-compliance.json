{
    "name": "eu-cookie-compliance-banner",
    "vendorUrl": "https://www.drupal.org/project/eu_cookie_compliance",
    "cosmetic": false,
    "detectCmp": [{ "exists": "body.eu-cookie-compliance-popup-open" }],
    "detectPopup": [{ "exists": "body.eu-cookie-compliance-popup-open" }],
    "optIn": [
        {
            "click": "#sliding-popup .agree-button, #sliding-popup .accept-all"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "#sliding-popup .decline-button, #sliding-popup .accept-necessary, #sliding-popup .eu-cookie-compliance-save-preferences-button, #sliding-popup .disagree-button:not(.find-more-button)"
            },
            "then": [
                {
                    "click": "#sliding-popup .decline-button, #sliding-popup .accept-necessary, #sliding-popup .eu-cookie-compliance-save-preferences-button, #sliding-popup .disagree-button:not(.find-more-button)"
                }
            ],
            "else": [
                {
                    "comment": "info-only notice without a reject button",
                    "hide": "#sliding-popup"
                }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "cookie-agreed=2",
            "negated": true
        }
    ]
}
