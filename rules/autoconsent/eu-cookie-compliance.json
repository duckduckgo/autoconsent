{
    "name": "eu-cookie-compliance-banner",
    "detectCmp": [{ "exists": "body.eu-cookie-compliance-popup-open" }],
    "detectPopup": [{ "exists": "body.eu-cookie-compliance-popup-open" }],
    "optIn": [
        {
            "click": ".eu-cookie-compliance-banner .agree-button, .eu-cookie-compliance-banner .accept-all"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": ".eu-cookie-compliance-banner .decline-button, .eu-cookie-compliance-banner .accept-necessary, .eu-cookie-compliance-banner .eu-cookie-compliance-reject-button, .eu-cookie-compliance-save-preferences-button"
            },
            "then": [
                {
                    "click": ".eu-cookie-compliance-banner .decline-button, .eu-cookie-compliance-banner .accept-necessary, .eu-cookie-compliance-banner .eu-cookie-compliance-reject-button, .eu-cookie-compliance-save-preferences-button"
                }
            ],
            "else": [
                { "exists": ".eu-cookie-compliance-banner #eu-cookie-compliance-categories" },
                { "eval": "EVAL_EU_COOKIE_COMPLIANCE_AGREE_SAVES_SELECTION" },
                {
                    "click": "#eu-cookie-compliance-categories input[type=\"checkbox\"]:checked:not(:disabled)",
                    "all": true,
                    "optional": true
                },
                { "click": ".eu-cookie-compliance-banner .agree-button" }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "cookie-agreed=2",
            "negated": true
        }
    ]
}
