{
    "name": "eu-cookie-compliance-banner",
    "detectCmp": [
        {
            "exists": "body.eu-cookie-compliance-popup-open, #sliding-popup .eu-cookie-compliance-banner-info"
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "exists": "body.eu-cookie-compliance-popup-open"
                },
                {
                    "visible": "#sliding-popup .eu-cookie-compliance-banner-info"
                }
            ]
        }
    ],
    "optIn": [
        {
            "click": ".eu-cookie-compliance-banner .agree-button, .eu-cookie-compliance-banner .accept-all"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": ".eu-cookie-compliance-banner .eu-cookie-compliance-reject-button, .eu-cookie-compliance-banner .decline-button, .eu-cookie-compliance-banner .accept-necessary"
            },
            "then": [
                {
                    "waitForThenClick": ".eu-cookie-compliance-banner .eu-cookie-compliance-reject-button, .eu-cookie-compliance-banner .decline-button, .eu-cookie-compliance-banner .accept-necessary",
                    "retry": 3
                }
            ],
            "else": [
                {
                    "click": ".eu-cookie-compliance-save-preferences-button"
                }
            ]
        }
    ],
    "test": [
        {
            "any": [
                {
                    "cookieContains": "cookie-agreed=2",
                    "negated": true
                },
                {
                    "cookieContains": "cookie-agreed-categories=[\"necessary\"]"
                }
            ]
        }
    ]
}
