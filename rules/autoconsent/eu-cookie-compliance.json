{
    "name": "eu-cookie-compliance-banner",
    "detectCmp": [
        {
            "exists": "body.eu-cookie-compliance-popup-open, #sliding-popup .eu-cookie-compliance-banner .decline-button"
        }
    ],
    "detectPopup": [
        {
            "any": [
                { "exists": "body.eu-cookie-compliance-popup-open" },
                {
                    "visible": "#sliding-popup.sliding-popup-bottom[style*='bottom: 0px'] .eu-cookie-compliance-banner, #sliding-popup.sliding-popup-top[style*='top: 0px'] .eu-cookie-compliance-banner",
                    "check": "any"
                }
            ]
        }
    ],
    "optIn": [
        {
            "click": ".eu-cookie-compliance-banner .agree-button, .eu-cookie-compliance-banner .accept-all"
        }
    ],
    "optOut": [
        {
            "click": ".eu-cookie-compliance-banner .decline-button, .eu-cookie-compliance-banner .accept-necessary, .eu-cookie-compliance-save-preferences-button"
        }
    ],
    "test": [
        {
            "cookieContains": "cookie-agreed=2",
            "negated": true
        }
    ]
}
