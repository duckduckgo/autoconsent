{
    "name": "react-cookie-consent",
    "vendorUrl": "https://github.com/Mastermindzh/react-cookie-consent",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [".CookieConsent"],
    "detectCmp": [
        {
            "exists": "#rcc-confirm-button"
        }
    ],
    "detectPopup": [
        {
            "visible": "#rcc-confirm-button"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#rcc-confirm-button"
        }
    ],
    "optOut": [
        {
            "if": { "exists": "#rcc-decline-button" },
            "then": [
                {
                    "waitForThenClick": "#rcc-decline-button",
                    "retry": 5,
                    "retryInterval": 500
                }
            ],
            "else": [
                {
                    "comment": "notice without a decline button: the confirm button stores consent, so hide the banner instead",
                    "hide": "div:has(> div > #rcc-confirm-button)"
                },
                {
                    "comment": "optional full-screen overlay wrapper",
                    "hide": "div[style*='position: fixed']:has(> div > div > #rcc-confirm-button)"
                }
            ]
        }
    ]
}
