{
    "name": "collectingcars",
    "vendorUrl": "https://collectingcars.com/",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?collecting(cars)?\\.com/"
    },
    "prehideSelectors": ["#cookie-banner"],
    "detectCmp": [{ "exists": "#cookie-banner [data-clickid=cookiepopup_managecookies]" }],
    "detectPopup": [{ "visible": "#cookie-banner [data-clickid=cookiepopup_managecookies]" }],
    "optIn": [{ "waitForThenClick": "#cookie-banner [data-clickid=cookiepopup_acceptall]" }],
    "optOut": [
        { "waitForThenClick": "#cookie-banner [data-clickid=cookiepopup_managecookies]" },
        { "waitForVisible": "[data-cy=acceptSelected]" },
        { "click": "input[data-widget=hdPreferenceToggle]:checked", "all": true, "optional": true },
        { "waitForThenClick": "[data-cy=acceptSelected]" }
    ],
    "test": [{ "cookieContains": "consentPreference=essential" }]
}
