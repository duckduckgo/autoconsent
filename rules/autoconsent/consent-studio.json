{
    "name": "consent-studio",
    "vendorUrl": "https://consent.studio/",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [".consent-studio .cookie-banner", ".consent-studio .consent-banner"],
    "detectCmp": [{ "exists": ".consent-studio [cs-role=consent-banner]" }],
    "detectPopup": [{ "visible": ".consent-studio [cs-role=consent-banner]" }],
    "optIn": [{ "waitForThenClick": ".consent-studio [cs-role=consent-banner] [data-cs-button=accept_all]" }],
    "optOut": [
        {
            "if": { "visible": ".consent-studio [cs-role=consent-banner] [data-cs-button=reject_all]" },
            "then": [{ "click": ".consent-studio [cs-role=consent-banner] [data-cs-button=reject_all]" }],
            "else": [
                {
                    "if": { "visible": ".consent-studio [cs-role=consent-banner] [cs-consent=reject]", "check": "any" },
                    "then": [{ "click": ".consent-studio [cs-role=consent-banner] [cs-consent=reject]" }],
                    "else": [
                        {
                            "if": {
                                "exists": ".consent-studio [cs-role=consent-banner] .cookie-banner__switch[aria-checked=true]:not([aria-disabled=true])"
                            },
                            "then": [
                                {
                                    "click": ".consent-studio [cs-role=consent-banner] .cookie-banner__switch[aria-checked=true]:not([aria-disabled=true])",
                                    "all": true
                                }
                            ]
                        },
                        { "waitForThenClick": ".consent-studio [cs-role=consent-banner] [data-cs-button=save]" }
                    ]
                }
            ]
        },
        { "waitForVisible": ".consent-studio [cs-role=consent-banner]", "check": "none" }
    ],
    "test": [{ "wait": 500 }, { "cookieContains": "consent-studio__storage=[%22functional%22]" }]
}
