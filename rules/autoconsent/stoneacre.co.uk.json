{
    "name": "stoneacre.co.uk",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?stoneacre\\.co\\.uk/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "#modal button[aria-label=\"Reject all non-essential cookies\"]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#modal button[aria-label=\"Reject all non-essential cookies\"]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#modal button[aria-label=\"Accept cookies\"]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#modal button[aria-label=\"Reject all non-essential cookies\"]"
        }
    ],
    "test": [
        {
            "waitForVisible": "#modal button[aria-label=\"Reject all non-essential cookies\"]",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
