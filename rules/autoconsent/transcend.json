{
    "name": "transcend",
    "vendorUrl": "https://transcend.io/",
    "cosmetic": true,
    "comment": "Transcend airgap ignores untrusted clicks, so the banner is closed via the UI API once it opens (after page load). Hiding the host would also block the site's own privacy-choices links.",
    "prehideSelectors": ["#transcend-consent-manager"],
    "detectCmp": [
        {
            "exists": "#transcend-consent-manager"
        },
        {
            "eval": "EVAL_TRANSCEND_SHOWN"
        }
    ],
    "detectPopup": [
        {
            "visible": "#transcend-consent-manager"
        },
        {
            "eval": "EVAL_TRANSCEND_SHOWN"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#transcend-consent-manager", "#consentManagerMainDialog .inner-container button"]
        }
    ],
    "optOut": [
        {
            "eval": "EVAL_TRANSCEND_HIDE"
        }
    ]
}
