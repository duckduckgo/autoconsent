{
    "name": "bbc.com",
    "runContext": {
        "urlPattern": "^https://(www\\.)?bbc\\.(com|co\\.uk)/"
    },
    "prehideSelectors": ["*[aria-labelledby=\"consent-banner-title\"]", "#bbccookies-prompt:has(#bbccookies-reject-button)"],
    "detectCmp": [
        {
            "any": [
                {
                    "exists": "#consent-banner-title"
                },
                {
                    "exists": "#bbccookies-reject-button"
                }
            ]
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "visible": "#consent-banner-title"
                },
                {
                    "visible": "#bbccookies-reject-button"
                }
            ]
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": "#bbccookies-accept-button"
            },
            "then": [
                {
                    "waitForThenClick": "#bbccookies-accept-button"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "button[data-testid=\"accept-button\"]"
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "#bbccookies-reject-button"
            },
            "then": [
                {
                    "waitForThenClick": "#bbccookies-reject-button"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "button[data-testid=\"reject-button\"]"
                }
            ]
        }
    ],
    "test": [
        {
            "wait": 500
        },
        {
            "cookieContains": "ckns_explicit=1"
        }
    ]
}
