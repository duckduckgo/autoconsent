{
    "name": "fondationbeyeler",
    "vendorUrl": "https://www.fondationbeyeler.ch/",
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?fondationbeyeler\\.ch/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "[role='dialog'] input[name='cookieConsent']"
        }
    ],
    "detectPopup": [
        {
            "visible": "[role='dialog'] button[type='submit']"
        },
        {
            "exists": "[role='dialog'] input[name='cookieConsent']"
        }
    ],
    "optIn": [],
    "optOut": [
        {
            "click": "[role='dialog'] button[role='checkbox'][data-state='checked']:not([data-disabled])",
            "all": true,
            "optional": true,
            "comment": "untick optional categories (Statistik is unticked by default)"
        },
        {
            "waitForThenClick": "[role='dialog'] button[type='submit']",
            "comment": "Auswahl bestätigen"
        }
    ],
    "test": [
        {
            "waitForVisible": "[role='dialog'] input[name='cookieConsent']",
            "timeout": 2000,
            "check": "none"
        }
    ]
}
