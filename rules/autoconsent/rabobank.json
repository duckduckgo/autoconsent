{
    "name": "rabobank",
    "vendorUrl": "https://www.rabobank.com/",
    "prehideSelectors": ["feature-modular-cookiebanner-variant-one .cookiebanner-container"],
    "detectCmp": [
        {
            "exists": "feature-modular-cookiebanner-variant-one .cookiebanner-container"
        }
    ],
    "detectPopup": [
        {
            "visible": "feature-modular-cookiebanner-variant-one .cookiebanner-container"
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": "#modular-cookiebanner-variant-one-consent-level-button-3"
            },
            "then": [
                {
                    "waitForThenClick": "#modular-cookiebanner-variant-one-consent-level-button-3",
                    "retry": 10,
                    "retryInterval": 500
                }
            ],
            "else": [
                {
                    "waitForThenClick": "feature-modular-cookiebanner-variant-one .cookiebanner-default-consent-button",
                    "retry": 10,
                    "retryInterval": 500
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "#modular-cookiebanner-variant-one-consent-level-button-1"
            },
            "then": [
                {
                    "waitForThenClick": "#modular-cookiebanner-variant-one-consent-level-button-1",
                    "retry": 10,
                    "retryInterval": 500
                }
            ],
            "else": [
                {
                    "waitForThenClick": "feature-modular-cookiebanner-variant-one .cookiebanner-default-consent-button",
                    "retry": 10,
                    "retryInterval": 500
                }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "RABO_PSL=1"
        }
    ]
}
