{
    "name": "walmart-ca",
    "vendorUrl": "https://www.walmart.ca/",
    "cosmetic": false,
    "runContext": {
        "urlPattern": "^https?://(www\\.)?walmart\\.ca/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "a[href=\"https://www.walmartcanada.ca/cookie-notice\"]"
        }
    ],
    "detectPopup": [
        {
            "visible": "a[href=\"https://www.walmartcanada.ca/cookie-notice\"]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "button[data-dca-intent=\"open\"][role=\"link\"]"
        },
        {
            "waitForThenClick": "xpath///button[contains(., 'Accept all') or contains(., 'Tout accepter')]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "button[data-dca-intent=\"open\"][role=\"link\"]",
            "retry": 5,
            "retryInterval": 500
        },
        {
            "waitFor": "#advertisingCookies",
            "timeout": 10000
        },
        {
            "if": {
                "exists": "#personalizationCookies:checked"
            },
            "then": [
                {
                    "click": "#personalizationCookies"
                }
            ]
        },
        {
            "if": {
                "exists": "#advertisingCookies:checked"
            },
            "then": [
                {
                    "click": "#advertisingCookies"
                }
            ]
        },
        {
            "waitForThenClick": "xpath///button[contains(., 'Save settings') or contains(., 'Enregistrer les paramètres')]"
        }
    ],
    "test": [
        {
            "cookieContains": "p13n=false&ads=false"
        },
        {
            "waitForVisible": "a[href=\"https://www.walmartcanada.ca/cookie-notice\"]",
            "check": "none",
            "timeout": 5000
        }
    ]
}
