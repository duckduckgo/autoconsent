{
    "name": "sitevision",
    "vendorUrl": "https://www.sitevision.se/",
    "prehideSelectors": [".sv-cookie-consent-banner", ".sv-cookie-consent-modal"],
    "detectCmp": [
        {
            "exists": ".sv-cookie-consent-banner, .sv-cookie-consent-modal"
        }
    ],
    "detectPopup": [
        {
            "visible": ".sv-cookie-consent-banner, .sv-cookie-consent-modal[open]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ":is(.sv-cookie-consent-banner, .sv-cookie-consent-modal) input[type=hidden][name=analytics] ~ button[type=submit]"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": ":is(.sv-cookie-consent-banner, .sv-cookie-consent-modal) input[type=hidden][name=necessary] ~ button[type=submit]"
            },
            "then": [
                {
                    "click": ":is(.sv-cookie-consent-banner, .sv-cookie-consent-modal) input[type=hidden][name=necessary] ~ button[type=submit]"
                }
            ],
            "else": [
                {
                    "click": ".sv-cookie-consent-banner button[type=button]"
                },
                {
                    "waitForVisible": ".sv-cookie-consent-banner button[type=submit][form]"
                },
                {
                    "click": ".sv-cookie-consent-banner form.env-form input[type=checkbox]:checked:not(:disabled)",
                    "all": true,
                    "optional": true
                },
                {
                    "click": ".sv-cookie-consent-banner button[type=submit][form]"
                }
            ]
        }
    ]
}
