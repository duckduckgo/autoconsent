{
    "name": "sitevision",
    "vendorUrl": "https://www.sitevision.se/",
    "prehideSelectors": [".sv-cookie-consent-banner,.sv-cookie-consent-modal"],
    "detectCmp": [
        {
            "exists": ".sv-cookie-consent-banner,.sv-cookie-consent-modal"
        }
    ],
    "detectPopup": [
        {
            "visible": ".sv-cookie-consent-banner, .sv-cookie-consent-modal > *",
            "check": "any",
            "comment": "a modal <dialog> sits in the top layer and has no offsetParent, so check its children"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".sv-cookie-consent-banner form:has(input[name=\"analytics\"]) button[type=\"submit\"], .sv-cookie-consent-modal form:has(input[name=\"analytics\"]) button[type=\"submit\"]"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": ".sv-cookie-consent-banner form:has(input[name=\"necessary\"]):not(:has(input[name=\"analytics\"])) button[type=\"submit\"], .sv-cookie-consent-modal form:has(input[name=\"necessary\"]):not(:has(input[name=\"analytics\"])) button[type=\"submit\"]"
            },
            "then": [
                {
                    "click": ".sv-cookie-consent-banner form:has(input[name=\"necessary\"]):not(:has(input[name=\"analytics\"])) button[type=\"submit\"], .sv-cookie-consent-modal form:has(input[name=\"necessary\"]):not(:has(input[name=\"analytics\"])) button[type=\"submit\"]"
                }
            ],
            "else": [
                {
                    "click": ".sv-cookie-consent-banner button[type=\"button\"], .sv-cookie-consent-modal .env-dialog__controls > button[type=\"button\"]"
                },
                {
                    "waitForVisible": ".sv-cookie-consent-banner button[type=\"submit\"][form], .sv-cookie-consent-modal button[type=\"submit\"][form]"
                },
                {
                    "click": ".sv-cookie-consent-banner form input[type=\"checkbox\"]:checked:not(:disabled), .sv-cookie-consent-modal form input[type=\"checkbox\"]:checked:not(:disabled)",
                    "all": true,
                    "optional": true
                },
                {
                    "click": ".sv-cookie-consent-banner button[type=\"submit\"][form], .sv-cookie-consent-modal button[type=\"submit\"][form]"
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": ".sv-cookie-consent-banner, .sv-cookie-consent-modal > *",
            "check": "none",
            "timeout": 2000
        }
    ]
}
