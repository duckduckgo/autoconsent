{
    "name": "worldbank",
    "vendorUrl": "https://www.worldbank.org/",
    "prehideSelectors": ["#cookieconsentpopup.lp__cookie_tooltip", ".privacy-widget:has(> button.accept-consent)"],
    "detectCmp": [
        {
            "exists": "#cookieconsentpopup.lp__cookie_tooltip, .privacy-widget > button.accept-consent"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookieconsentpopup.lp__cookie_tooltip, .privacy-widget:has(> button.accept-consent)"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#cookieconsentpopup .accept-consent, .privacy-widget > button.accept-consent"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#cookieconsentpopup .accept-consent, .privacy-widget > button.accept-consent"
        }
    ],
    "test": [
        {
            "cookieContains": "consent_cookie=1"
        }
    ]
}
