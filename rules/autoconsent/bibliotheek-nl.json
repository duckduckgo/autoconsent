{
    "name": "bibliotheek-nl",
    "_metadata": {
        "vendorUrl": "https://www.bibliotheek.nl/"
    },
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [".modalwindow-container:has(.modalwindow-footer button.button.primary.notok)"],
    "detectCmp": [
        {
            "exists": "#bibliotheek-nl-page .modalwindow-container .modalwindow-footer button.button.primary.notok"
        }
    ],
    "detectPopup": [
        {
            "visible": "#bibliotheek-nl-page .modalwindow-container .modalwindow-footer button.button.primary.notok"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#bibliotheek-nl-page .modalwindow-container .modalwindow-footer button.button.primary.ok"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#bibliotheek-nl-page .modalwindow-container .modalwindow-footer button.button.primary.notok"
        }
    ]
}
