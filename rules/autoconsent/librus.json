{
    "name": "librus",
    "vendorUrl": "https://portal.librus.pl/",
    "runContext": {
        "urlPattern": "^https?://([a-z0-9-]+\\.)?librus\\.pl/"
    },
    "prehideSelectors": ["[class*=\"cookiesPolicyDrawerBackground\"]"],
    "detectCmp": [{ "exists": "[class*=\"cookiesPolicyWrapper\"] > [class*=\"_actions_\"] > button[class*=\"buttonDefault\"]" }],
    "detectPopup": [{ "visible": "[class*=\"cookiesPolicyWrapper\"] > [class*=\"_actions_\"] > button[class*=\"buttonDefault\"]" }],
    "optIn": [{ "waitForThenClick": "[class*=\"cookiesPolicyWrapper\"] > [class*=\"_actions_\"] > button[class*=\"buttonSecondary\"]" }],
    "optOut": [
        { "waitForThenClick": "[class*=\"cookiesPolicyWrapper\"] > [class*=\"_actions_\"] > button[class*=\"buttonDefault\"]" },
        { "waitForVisible": "[class*=\"cookiesPolicyWrapper\"] [class*=\"customizeDialogBackButton\"]" },
        {
            "if": { "exists": "[class*=\"cookiesPolicyWrapper\"] input[role=switch]:checked:not(:disabled)" },
            "then": [{ "click": "[class*=\"cookiesPolicyWrapper\"] input[role=switch]:checked:not(:disabled)", "all": true }]
        },
        { "waitForThenClick": "[class*=\"cookiesPolicyWrapper\"] > [class*=\"_actions_\"] > button[class*=\"buttonDefault\"]" }
    ],
    "test": [{ "waitForVisible": "[class*=\"cookiesPolicyWrapper\"]", "check": "none", "timeout": 2000 }]
}
