{
    "name": "up-cookie-consent",
    "prehideSelectors": [".upcc-cookie-widget"],
    "detectCmp": [{ "exists": ".upcc-cookie-widget" }],
    "detectPopup": [{ "visible": ".upcc-cookie-widget" }],
    "optIn": [{ "waitForThenClick": ".upcc-cookie-widget .upcc-cookie-accept" }],
    "optOut": [
        {
            "if": { "exists": ".upcc-cookie-widget .upcc-cookie-reject-all" },
            "then": [{ "click": ".upcc-cookie-widget .upcc-cookie-reject-all" }],
            "else": [
                { "click": ".upcc-cookie-widget .js-upcc-view-upcc-cookie-options" },
                { "waitForThenClick": ".upcc-cookie-modal-container .upcc-cookie-reject-all" }
            ]
        },
        { "waitForVisible": ".upcc-cookie-widget, .upcc-cookie-modal-container", "check": "none", "timeout": 5000, "optional": true }
    ],
    "test": [{ "cookieContains": "up-cookie-consent-options=[\"strictly_necessary\"]" }]
}
