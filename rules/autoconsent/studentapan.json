{
    "name": "studentapan",
    "_metadata": { "vendorUrl": "https://www.studentapan.se/" },
    "runContext": { "urlPattern": "^https?://(www\\.)?studentapan\\.se/" },
    "prehideSelectors": ["dialog[aria-labelledby=\"cookie-consent-title\"]"],
    "detectCmp": [{ "exists": "dialog[aria-labelledby=\"cookie-consent-title\"]" }],
    "detectPopup": [{ "visible": "dialog[aria-labelledby=\"cookie-consent-title\"]" }],
    "optIn": [{ "waitForThenClick": "dialog[aria-labelledby=\"cookie-consent-title\"] button[class*=\"_primaryButton\"]" }],
    "optOut": [
        { "waitForThenClick": "dialog[aria-labelledby=\"cookie-consent-title\"] button[class*=\"_secondaryButton\"]" },
        { "waitForVisible": "[role=\"dialog\"] [class*=\"_consentItem\"]" },
        { "click": "[role=\"dialog\"] [class*=\"_consentItem\"] input[type=\"checkbox\"]:checked", "all": true, "optional": true },
        { "waitForThenClick": "[role=\"dialog\"]:has([class*=\"_consentItem\"]) [class*=\"_footer\"] button" }
    ],
    "test": [{ "cookieContains": "targTK=false" }]
}
