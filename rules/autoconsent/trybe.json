{
    "name": "trybe",
    "vendorUrl": "https://try.be",
    "cosmetic": false,
    "prehideSelectors": [".react-cookie-policy"],
    "detectCmp": [{ "exists": ".react-cookie-policy" }],
    "detectPopup": [{ "visible": ".react-cookie-policy #cookie-policy" }],
    "optIn": [
        {
            "waitForThenClick": ".react-cookie-policy #cookie-policy button.bg-accent"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".react-cookie-policy #cookie-policy button:not(.bg-accent)"
        },
        {
            "waitFor": "[id^='headlessui-dialog-panel'] button[role='switch']"
        },
        {
            "click": "[id^='headlessui-dialog-panel'] button[role='switch'][aria-checked='true']:not([disabled])",
            "all": true,
            "optional": true
        },
        {
            "waitForThenClick": "[id^='headlessui-dialog-panel'] ul + button"
        }
    ],
    "test": [
        { "wait": 500 },
        {
            "cookieContains": "trybe_cookies_consent_tracking=false"
        }
    ]
}
