{
    "name": "urvaerket",
    "vendorUrl": "https://www.urvaerket.dk/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?(urvaerket\\.dk|uret\\.se|urverket\\.no|laatukellot\\.fi|thewatchagency\\.com)/"
    },
    "prehideSelectors": ["app-cookie-consent > .cookie-banner"],
    "detectCmp": [
        {
            "exists": "app-cookie-consent .cookie-banner"
        }
    ],
    "detectPopup": [
        {
            "visible": "app-cookie-consent .cookie-banner"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "app-cookie-consent .cookie-banner > div > button:nth-of-type(1)"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "app-cookie-consent .cookie-banner > div > button:nth-of-type(2)"
        }
    ],
    "test": [
        {
            "cookieContains": "%22analytics%22%3Afalse%2C%22marketing%22%3Afalse"
        }
    ]
}
