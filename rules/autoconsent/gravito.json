{
    "name": "gravito",
    "vendorUrl": "https://www.gravito.net/cmp/",
    "prehideSelectors": ["#gravitoCMPRoot"],
    "detectCmp": [
        {
            "exists": "#gravitoCMPRoot [id^=gravito][id$=-layer1-accept-all]"
        }
    ],
    "detectPopup": [
        {
            "visible": "#gravitoCMPRoot [id^=gravito][id$=-layer1-accept-all]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#gravitoCMPRoot [id^=gravito][id$=-layer1-accept-all]"
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": "#gravitoCMPRoot [id^=gravito][id$=-layer1-reject-all]"
            },
            "then": [
                {
                    "click": "#gravitoCMPRoot [id^=gravito][id$=-layer1-reject-all]"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "#gravitoCMPRoot [id^=gravito][id$=-layer1-settings]"
                },
                {
                    "waitForThenClick": "#gravitoCMPRoot [id^=gravito][id$=-layer2-reject-all]"
                }
            ]
        },
        {
            "waitForVisible": "#gravitoCMPRoot [id^=gravito][id$=-layer1-accept-all]",
            "check": "none",
            "timeout": 2000,
            "optional": true
        }
    ],
    "test": [
        {
            "cookieContains": "gravitoData"
        }
    ]
}
