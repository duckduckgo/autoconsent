{
    "name": "gravito",
    "vendorUrl": "https://www.gravito.net/cmp/",
    "prehideSelectors": ["#gravitoCMPRoot .gravitoCMP-opaque-container"],
    "detectCmp": [
        {
            "exists": "#gravitoCMPRoot .gravitoCMP-opaque-container"
        }
    ],
    "detectPopup": [
        {
            "visible": "#gravitoCMP-tab-container-id #gravitoTCFCMP-layer1-settings"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#gravitoTCFCMP-layer1-accept-all"
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": "#gravitoTCFCMP-layer1-reject-all"
            },
            "then": [
                {
                    "click": "#gravitoTCFCMP-layer1-reject-all"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "#gravitoTCFCMP-layer1-settings"
                },
                {
                    "waitForThenClick": "#gravitoTCFCMP-layer2-reject-all"
                }
            ]
        },
        {
            "waitForVisible": "#gravitoCMP-tab-container-id",
            "check": "none",
            "timeout": 3000,
            "optional": true
        }
    ],
    "test": [
        {
            "cookieContains": "gravitoData="
        }
    ]
}
