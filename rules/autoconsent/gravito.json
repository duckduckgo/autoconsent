{
    "name": "gravito",
    "vendorUrl": "https://www.gravito.net/cmp/",
    "prehideSelectors": ["#gravitoCMPRoot"],
    "detectCmp": [
        {
            "exists": "#gravitoCMPRoot [id$='-layer1-settings']"
        }
    ],
    "detectPopup": [
        {
            "visible": "#gravitoCMPRoot [id$='-layer1-settings']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#gravitoCMPRoot [id$='-layer1-accept-all']"
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": "#gravitoCMPRoot [id$='-layer1-reject-all']"
            },
            "then": [
                {
                    "click": "#gravitoCMPRoot [id$='-layer1-reject-all']"
                }
            ],
            "else": [
                {
                    "click": "#gravitoCMPRoot [id$='-layer1-settings']"
                },
                {
                    "waitForThenClick": "#gravitoCMPRoot [id$='-layer2-reject-all']"
                }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "gravitoData"
        }
    ]
}
