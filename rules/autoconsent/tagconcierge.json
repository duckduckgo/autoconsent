{
    "name": "tagconcierge",
    "_metadata": {
        "vendorUrl": "https://tagconcierge.com/consent-mode-banner-cookie-consent-management"
    },
    "prehideSelectors": ["#consent-banner-main"],
    "detectCmp": [{ "exists": "#consent-banner-main" }],
    "detectPopup": [{ "visible": "#consent-banner-modal" }],
    "optIn": [{ "waitForThenClick": "#consent-banner-modal a[href=\"#accept\"]" }],
    "optOut": [
        {
            "if": { "visible": "#consent-banner-modal a[href=\"#reject\"]" },
            "then": [{ "click": "#consent-banner-modal a[href=\"#reject\"]" }],
            "else": [
                { "waitForThenClick": "#consent-banner-modal a[href=\"#settings\"]" },
                { "waitForVisible": "#consent-banner-settings" },
                {
                    "if": { "exists": "#consent-banner-settings a[href=\"#reject\"]" },
                    "then": [{ "click": "#consent-banner-settings a[href=\"#reject\"]" }],
                    "else": [
                        {
                            "click": "#consent-banner-settings input[type=\"checkbox\"]:checked:not(:disabled)",
                            "all": true,
                            "optional": true
                        },
                        { "waitForThenClick": "#consent-banner-settings a[href=\"#save\"]" }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "any": [
                { "visible": "#consent-banner-main", "check": "none" },
                { "visible": "#consent-banner-modal, #consent-banner-settings", "check": "none" }
            ]
        }
    ]
}
