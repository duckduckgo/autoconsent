{
    "name": "epaas",
    "prehideSelectors": ["epaas-consent-drawer-shell"],
    "detectCmp": [{ "exists": "epaas-consent-drawer-shell" }],
    "detectPopup": [{ "visible": ["epaas-consent-drawer-shell", "section.consentDrawer"] }],
    "optIn": [{ "waitForThenClick": ["epaas-consent-drawer-shell", "button.accept-button"] }],
    "optOut": [
        {
            "if": { "exists": ["epaas-consent-drawer-shell", "button.reject-button"] },
            "then": [{ "waitForThenClick": ["epaas-consent-drawer-shell", "button.reject-button"] }],
            "else": [
                { "waitForThenClick": ["epaas-consent-drawer-shell", "button.personalize-button"] },
                { "waitFor": ["epaas-consent-drawer-shell", "epaas-policy-page-shell"] },
                {
                    "waitFor": ["epaas-consent-drawer-shell", "epaas-policy-page-shell", "label[class*='category-header__switch']"],
                    "optional": true
                },
                {
                    "click": ["epaas-consent-drawer-shell", "epaas-policy-page-shell", "label.category-header__switch--on input"],
                    "all": true,
                    "optional": true
                },
                { "waitFor": ["epaas-consent-drawer-shell", "section.consentDrawer.layered button.accept-button"] },
                {
                    "if": { "exists": ["epaas-consent-drawer-shell", "button.save-button"] },
                    "then": [{ "click": ["epaas-consent-drawer-shell", "button.save-button"] }],
                    "else": [
                        { "waitFor": ["epaas-consent-drawer-shell", "epaas-policy-page-shell", "label.category-header__switch--off"] },
                        { "click": ["epaas-consent-drawer-shell", "button.accept-button"] }
                    ]
                }
            ]
        }
    ],
    "test": [{ "cookieContains": "%22advertising%22%3A0" }]
}
