{
    "name": "sas",
    "vendorUrl": "https://www.flysas.com/",
    "prehideSelectors": ["dialog[aria-labelledby=\"cookie-dialog-title\"]:has(#deny-consent-button)"],
    "detectCmp": [
        {
            "exists": "dialog[aria-labelledby=\"cookie-dialog-title\"] #deny-consent-button"
        }
    ],
    "detectPopup": [
        {
            "visible": "dialog[aria-labelledby=\"cookie-dialog-title\"] #deny-consent-button"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "dialog[aria-labelledby=\"cookie-dialog-title\"] #deny-consent-button + button"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "dialog[aria-labelledby=\"cookie-dialog-title\"] #deny-consent-button"
        }
    ],
    "test": [
        {
            "cookieContains": "%22statistic%22%3Afalse"
        }
    ]
}
