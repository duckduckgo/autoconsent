{
    "name": "ciaopeople.it",
    "prehideSelectors": [".layer1 > .gdpr-modal"],
    "detectCmp": [{ "exists": ".gdpr-modal__box-top-sx > img[src*='.ciaopeople.it/']" }],
    "detectPopup": [{ "visible": ".layer1 > .gdpr-modal" }],
    "optIn": [{ "waitForThenClick": ".layer1 .gdpr-modal__box-bottom-dx > button.gdpr-btn--icon" }],
    "optOut": [{ "waitForThenClick": ".layer1 .gdpr-modal__box-top-dx > button" }],
    "test": [
        {
            "waitForVisible": ".gdpr-modal",
            "check": "none",
            "timeout": 3000
        }
    ]
}
