{
    "name": "ciaopeople.it",
    "prehideSelectors": [".gdpr-modal:has(.gdpr-modal__box-top-dx)"],
    "detectCmp": [{ "exists": ".gdpr-modal .gdpr-modal__box-top-dx > button.gdpr-btn" }],
    "detectPopup": [{ "visible": ".gdpr-modal .gdpr-modal__box-top-dx > button.gdpr-btn" }],
    "optIn": [{ "waitForThenClick": ".gdpr-modal .gdpr-modal__box-bottom-dx > button.gdpr-btn:first-child" }],
    "optOut": [{ "waitForThenClick": ".gdpr-modal .gdpr-modal__box-top-dx > button.gdpr-btn" }],
    "test": [
        {
            "visible": ".gdpr-modal",
            "check": "none"
        }
    ]
}
