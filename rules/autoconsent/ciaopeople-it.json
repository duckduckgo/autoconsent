{
    "name": "ciaopeople.it",
    "prehideSelectors": [".gdpr-modal:has(img[src*=\".ciaopeople.it/\"])"],
    "detectCmp": [{ "exists": ".gdpr-modal .gdpr-modal__box-top-sx img[src*=\".ciaopeople.it/\"]" }],
    "detectPopup": [{ "visible": ".gdpr-modal .gdpr-modal__box" }],
    "optIn": [{ "waitForThenClick": ".gdpr-modal__box-bottom-dx > button.gdpr-btn--icon" }],
    "optOut": [{ "waitForThenClick": ".gdpr-modal__box-top-dx > button" }],
    "test": [{ "waitForVisible": ".gdpr-modal .gdpr-modal__box", "check": "none", "timeout": 5000 }]
}
