{
    "name": "pabcogypsum",
    "vendorUrl": "https://pabcogypsum.com/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?pabcogypsum\\.com/"
    },
    "prehideSelectors": [".js-data-prefs-dialog"],
    "detectCmp": [{ "exists": ".js-data-prefs-dialog #data-prefs-form" }],
    "detectPopup": [{ "visible": ".js-data-prefs-dialog #data-prefs-form" }],
    "optIn": [
        { "click": "#data-prefs-form input.toggle:not(:checked) + label.toggle-label", "all": true, "optional": true },
        { "waitForThenClick": "#data-prefs-form button[type=submit][value=save]" }
    ],
    "optOut": [
        { "waitForVisible": "#data-prefs-form button[type=submit][value=save]" },
        { "click": "#data-prefs-form input.toggle:checked + label.toggle-label", "all": true, "optional": true },
        { "waitForThenClick": "#data-prefs-form button[type=submit][value=save]" }
    ],
    "test": [
        { "cookieContains": "allowed_cookies_analytics=0" },
        { "cookieContains": "allowed_cookies_functional=0" },
        { "cookieContains": "allowed_cookies_targeting=0" }
    ]
}
