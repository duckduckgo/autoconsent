{
    "name": "bold-cookie-consent",
    "vendorUrl": "https://www.bold.com/",
    "cosmetic": false,
    "prehideSelectors": ["#cookie-consent-banner", "#ccpa-consent-banner", "#ccpa-v2-consent-banner"],
    "detectCmp": [
        {
            "exists": "#cookie-consent-banner [data-id=\"cookie-consent-banner-modal\"], #ccpa-v2-consent-banner [data-id=\"cookie-consent-banner-modal\"]"
        }
    ],
    "detectPopup": [
        {
            "if": { "visible": "#ccpa-consent-banner" },
            "then": [{ "visible": "#ccpa-consent-banner" }],
            "else": [
                {
                    "if": { "exists": "#ccpa-v2-consent-banner" },
                    "then": [{ "visible": "#ccpa-v2-consent-banner #idCCPABanner" }],
                    "else": [
                        { "visible": "#cookie-consent-banner" },
                        { "visible": "#cookie-consent-banner .banner-gdpr, #cookie-consent-banner #gdpr-modal", "check": "any" }
                    ]
                }
            ]
        }
    ],
    "optIn": [
        {
            "if": { "visible": "#ccpa-consent-banner" },
            "then": [{ "click": "#ccpa-consent-banner [data-id=\"btn-close-ccpa\"]" }],
            "else": [
                {
                    "if": { "exists": "#ccpa-v2-consent-banner" },
                    "then": [{ "click": "#ccpa-v2-consent-banner [data-id=\"btn-close-ccpa-banner\"]" }],
                    "else": [{ "click": "#cookie-consent-banner [data-id=\"btn-accept-ccokies\"]" }]
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": { "visible": "#ccpa-consent-banner" },
            "then": [
                { "click": "#ccpa-consent-banner [data-id=\"btn-close-ccpa\"]" },
                { "waitForVisible": "#ccpa-consent-banner", "check": "none", "timeout": 3000, "optional": true }
            ],
            "else": [
                {
                    "if": { "exists": "#ccpa-v2-consent-banner" },
                    "then": [
                        { "click": "#ccpa-v2-consent-banner [data-id=\"pre-banner-btn\"]" },
                        { "waitForVisible": "#ccpa-v2-consent-banner [data-id=\"cookie-consent-banner-modal\"]" },
                        {
                            "click": "#ccpa-v2-consent-banner [data-id=\"cookie-consent-banner-modal\"] input[type=\"checkbox\"]:checked:not(:disabled)",
                            "all": true,
                            "optional": true
                        },
                        { "click": "#ccpa-v2-consent-banner [data-id=\"btn-save-preference\"]" },
                        { "waitForVisible": "#ccpa-v2-consent-banner #idCCPABanner", "check": "none", "timeout": 3000, "optional": true }
                    ],
                    "else": [
                        {
                            "if": {
                                "visible": "#cookie-consent-banner [data-id=\"btnGdprRejectAll\"], #cookie-consent-banner [data-id=\"btn-contd-without-accpting\"]",
                                "check": "any"
                            },
                            "then": [
                                {
                                    "click": "#cookie-consent-banner [data-id=\"btnGdprRejectAll\"], #cookie-consent-banner [data-id=\"btn-contd-without-accpting\"]"
                                }
                            ],
                            "else": [
                                { "click": "#cookie-consent-banner [data-id=\"pre-banner-btn\"]" },
                                { "waitForVisible": "#cookie-consent-banner [data-id=\"cookie-consent-banner-modal\"]" },
                                {
                                    "click": "#cookie-consent-banner [data-id=\"cookie-consent-banner-modal\"] input[type=\"checkbox\"]:checked:not(:disabled)",
                                    "all": true,
                                    "optional": true
                                },
                                { "click": "#cookie-consent-banner [data-id=\"btn-save-preference\"]" }
                            ]
                        },
                        { "waitForVisible": "#cookie-consent-banner", "check": "none", "timeout": 3000, "optional": true }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "if": { "exists": "#ccpa-consent-banner" },
            "then": [{ "visible": "#ccpa-consent-banner", "check": "none" }],
            "else": [
                {
                    "if": { "exists": "#ccpa-v2-consent-banner" },
                    "then": [{ "cookieContains": "\"advertising\":false" }],
                    "else": [{ "visible": "#cookie-consent-banner", "check": "none" }]
                }
            ]
        }
    ]
}
