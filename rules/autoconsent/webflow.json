{
    "name": "webflow",
    "vendorUrl": "https://finsweet.com/cookie-consent",
    "prehideSelectors": [".fs-cc-components,[fs-cc=banner]"],
    "detectCmp": [
        {
            "visible": ".fs-cc-components,[fs-cc=banner]"
        }
    ],
    "detectPopup": [
        {
            "visible": ".fs-cc-components,[fs-cc=banner]"
        },
        {
            "visible": "[fs-cc=banner] [fs-cc=allow],[fs-cc=banner] [fs-cc=deny],[fs-cc=banner] [fs-cc=close]",
            "check": "any"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[fs-cc=banner] [fs-cc=allow]"
        }
    ],
    "optOut": [
        {
            "if": { "exists": "script[fs-cc-mode=informational]" },
            "then": [
                {
                    "comment": "in informational mode closing the banner accepts all, so deny via the hidden preferences form and hide the banner",
                    "if": { "exists": "[fs-cc=preferences] [fs-cc=deny]" },
                    "then": [{ "click": "[fs-cc=preferences] [fs-cc=deny]" }]
                },
                {
                    "hide": "[fs-cc=banner]"
                }
            ],
            "else": [
                {
                    "if": { "exists": "[fs-cc=banner] [fs-cc=deny]" },
                    "then": [
                        { "wait": 500 },
                        {
                            "waitForThenClick": "[fs-cc=banner] [fs-cc=deny]"
                        }
                    ],
                    "else": [
                        {
                            "hide": "[fs-cc=banner]"
                        }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "fs-cc"
        }
    ]
}
