{
    "name": "stumpel.nl",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?stumpel\\.nl/"
    },
    "prehideSelectors": [".cookies-control__container"],
    "detectCmp": [
        {
            "exists": ".cookies-control .cookies-control__close"
        }
    ],
    "detectPopup": [
        {
            "visible": ".cookies-control__container"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".cookies-control .cookies-control__accept-button",
            "retry": 10,
            "retryInterval": 500
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".cookies-control .cookies-control__close",
            "retry": 10,
            "retryInterval": 500
        }
    ],
    "test": [
        {
            "cookieContains": "%22analyticsCookies%22%3Afalse%2C%22marketingCookies%22%3Afalse"
        }
    ]
}
