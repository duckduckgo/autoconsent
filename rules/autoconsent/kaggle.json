{
    "name": "kaggle",
    "vendorUrl": "https://www.kaggle.com/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?kaggle\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "xpath///div[@data-nosnippet][contains(., 'uses cookies from Google')]" }],
    "detectPopup": [{ "visible": "xpath///div[@data-nosnippet][contains(., 'uses cookies from Google')]" }],
    "optIn": [
        {
            "waitForThenClick": "xpath///div[@data-nosnippet][contains(., 'uses cookies from Google')]/following-sibling::div/div[contains(., 'Got it')]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "xpath///div[@data-nosnippet][contains(., 'uses cookies from Google')]/following-sibling::div/div[contains(., 'Got it')]"
        }
    ],
    "test": [{ "cookieContains": "ACCEPTED_COOKIES=true" }]
}
