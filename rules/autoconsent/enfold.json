{
    "name": "enfold",
    "vendorUrl": "https://kriesi.at/themes/enfold/",
    "cosmetic": false,
    "prehideSelectors": [".avia-cookie-consent"],
    "detectCmp": [
        {
            "exists": ".avia-cookie-consent-wrap .avia-cookie-consent"
        }
    ],
    "detectPopup": [
        {
            "visible": ".avia-cookie-consent:not(.cookiebar-hidden)"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".avia-cookie-consent .avia-cookie-close-bar"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "html.av-cookies-consent-message-bar-only"
            },
            "then": [
                {
                    "waitForThenClick": ".avia-cookie-consent .avia-cookie-close-bar"
                }
            ],
            "else": [
                {
                    "eval": "EVAL_ENFOLD_DISABLE_REFUSE_ALERT"
                },
                {
                    "if": {
                        "exists": ".avia-cookie-consent .avia-cookie-hide-notification"
                    },
                    "then": [
                        {
                            "waitForThenClick": ".avia-cookie-consent .avia-cookie-hide-notification"
                        }
                    ],
                    "else": [
                        {
                            "waitForThenClick": ".avia-cookie-consent .avia-cookie-info-btn"
                        },
                        {
                            "waitForThenClick": "#av-consent-extra-info .avia-cookie-hide-notification"
                        }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "if": {
                "exists": "html.av-cookies-consent-message-bar-only"
            },
            "then": [
                {
                    "cookieContains": "aviaCookieConsent="
                }
            ],
            "else": [
                {
                    "exists": "html.av-cookies-session-refused"
                }
            ]
        }
    ]
}
