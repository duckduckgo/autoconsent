{
    "name": "europa-eu",
    "vendorUrl": "https://ec.europa.eu/",
    "runContext": {
        "urlPattern": "^https://([\\w-]+\\.)*europa\\.eu/"
    },
    "prehideSelectors": ["#cookie-consent-banner"],
    "detectCmp": [
        {
            "exists": ".wt-cck--container"
        }
    ],
    "detectPopup": [
        {
            "visible": ".wt-cck--container"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".wt-cck--actions-button[href=\"#accept\"]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".wt-cck--actions-button[href=\"#refuse\"]"
        }
    ],
    "test": [
        {
            "cookieContains": "cck1=%7B%22cm%22%3Atrue%2C%22all1st%22%3Afalse%7D"
        }
    ]
}
