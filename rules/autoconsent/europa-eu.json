{
    "name": "europa-eu",
    "vendorUrl": "https://ec.europa.eu/",
    "runContext": {
        "urlPattern": "^https://([a-z0-9.-]*\\.)?europa\\.eu/"
    },
    "prehideSelectors": ["#cookie-consent-banner .wt-cck--container"],
    "detectCmp": [
        {
            "exists": "#cookie-consent-banner .wt-cck--container"
        }
    ],
    "detectPopup": [
        {
            "visible": "#cookie-consent-banner .wt-cck--container"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".wt-cck--actions-button[href=\"#accept\"]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".wt-cck--actions-button[href=\"#refuse\"]"
        }
    ],
    "test": [
        {
            "cookieContains": "%22cm%22%3Atrue%2C%22all1st%22%3Afalse"
        }
    ]
}
