{
    "name": "ionos.de",
    "prehideSelectors": [".privacy-consent--backdrop", ".privacy-consent--modal"],
    "detectCmp": [{ "exists": ".privacy-consent--modal" }],
    "detectPopup": [{ "visible": ".privacy-consent--modal" }],
    "optIn": [{ "waitForThenClick": ".privacy-consent--modal [data-testid='confirm-all']" }],
    "optOut": [
        {
            "if": { "visible": ".privacy-consent--modal [data-testid='confirm-selection']" },
            "then": [{ "waitForThenClick": ".privacy-consent--modal [data-testid='confirm-selection']", "comment": "Ablehnen" }],
            "else": [{ "waitForThenClick": ".privacy-consent--modal #confirmSelection", "comment": "inline 'refuser' link" }]
        }
    ],
    "test": [{ "waitForVisible": ".privacy-consent--modal", "check": "none", "timeout": 2000 }]
}
