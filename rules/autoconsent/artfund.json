{
    "name": "artfund.org",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?artfund\\.org/"
    },
    "prehideSelectors": [".cookie-banner"],
    "detectCmp": [{ "exists": ".cookie-banner .cookie-banner__button-column" }],
    "detectPopup": [{ "visible": ".cookie-banner.cookie-banner--visible" }],
    "optIn": [{ "waitForThenClick": ".cookie-banner__button-column .form-btn button" }],
    "optOut": [
        { "waitForThenClick": ".cookie-banner__button-column > div.cursor-pointer" },
        {
            "waitForThenClick": "xpath///div[contains(@class, 'cookie-dialogue')]//footer//button[normalize-space()='Reject cookies']"
        },
        { "waitForVisible": ".cookie-banner.cookie-banner--visible", "check": "none", "timeout": 2000, "optional": true }
    ],
    "test": [{ "cookieContains": "cookieconsent_preferences_v5={%22analytics%22:false%2C%22marketing%22:false}" }]
}
