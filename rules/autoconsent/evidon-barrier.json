{
    "name": "evidon-barrier",
    "vendorUrl": "https://www.crownpeak.com/",
    "cosmetic": false,
    "prehideSelectors": ["#_evidon-barrier-wrapper"],
    "detectCmp": [{ "exists": "#_evidon-barrier-wrapper #_evidon-banner" }],
    "detectPopup": [{ "visible": "#_evidon-barrier-wrapper #_evidon-banner" }],
    "optIn": [{ "waitForThenClick": "#_evidon-banner-acceptbutton" }],
    "optOut": [
        { "waitForThenClick": "#_evidon-barrier-declinebutton" },
        { "waitForVisible": "#_evidon-barrier-wrapper", "check": "none", "timeout": 5000 }
    ]
}
