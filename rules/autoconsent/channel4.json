{
    "name": "channel4.com",
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?channel4\\.com/"
    },
    "prehideSelectors": [".cookie-banner .all4-cc-popup-roadblock"],
    "detectCmp": [{ "exists": ".cookie-banner .all4-cc-primary-button" }],
    "detectPopup": [
        {
            "visible": ".cookie-banner .all4-cc-primary-button"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".cookie-banner .all4-cc-primary-button"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".cookie-banner button[aria-label=\"Reject non-essential cookies and continue.\"]"
        }
    ],
    "test": [{ "cookieContains": "C4_CC=eyJ2ZXJzaW9uIjoxLCJjb25zZW50ZWQiOnRydWUs" }]
}
