{
    "name": "temu",
    "vendorUrl": "https://temu.com",
    "runContext": {
        "urlPattern": "^https://([a-z0-9-]+\\.)?temu\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "div:has([href=\"cookiePrivacyLink\"]) + div:has(> [role=button][aria-label])"
        }
    ],
    "detectPopup": [
        {
            "visible": "div:has([href=\"cookiePrivacyLink\"]) + div:has(> [role=button][aria-label])"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "div:has([href=\"cookiePrivacyLink\"]) + div:has(> [role=button][aria-label]) > [role=button][aria-label]:not(:nth-child(2))"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "div:has([href=\"cookiePrivacyLink\"]) + div:has(> [role=button][aria-label]) > [role=button][aria-label]:nth-child(2)"
        }
    ],
    "test": [
        {
            "wait": 500
        },
        {
            "cookieContains": "privacy_setting_detail=%7B%22adsChoice%22%3A%220"
        }
    ]
}
