{
    "name": "trustpilot.com",
    "prehideSelectors": ["#onetrust-banner-sdk,#onetrust-consent-sdk,.onetrust-pc-dark-filter"],
    "runContext": {
        "urlPattern": "^https?://(www\\.)?trustpilot\\.com/"
    },
    "detectCmp": [{ "exists": "#onetrust-banner-sdk" }],
    "detectPopup": [{ "visible": "#onetrust-banner-sdk" }],
    "optIn": [{ "waitForThenClick": "#onetrust-accept-btn-handler" }],
    "optOut": [
        {
            "if": { "visible": "#onetrust-reject-all-handler" },
            "then": [{ "click": "#onetrust-reject-all-handler" }],
            "else": [
                { "waitForThenClick": "#onetrust-pc-btn-handler" },
                { "waitFor": "#onetrust-consent-sdk input.category-switch-handler:checked" },
                {
                    "click": "#onetrust-consent-sdk input.category-switch-handler:checked",
                    "all": true
                },
                { "waitForThenClick": ".save-preference-btn-handler" }
            ]
        }
    ]
}
