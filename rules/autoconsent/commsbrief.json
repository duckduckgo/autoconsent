{
    "name": "commsbrief",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?commsbrief\\.com/"
    },
    "prehideSelectors": ["#moove_gdpr_cookie_info_bar"],
    "detectCmp": [{ "exists": "#moove_gdpr_cookie_info_bar" }],
    "detectPopup": [{ "visible": "#moove_gdpr_cookie_info_bar:not(.moove-gdpr-info-bar-hidden)" }],
    "optIn": [{ "waitForThenClick": ".moove-gdpr-infobar-allow-all" }],
    "optOut": [
        { "waitForThenClick": "#moove_gdpr_cookie_info_bar .change-settings-button" },
        { "waitForVisible": "#moove_gdpr_cookie_modal" },
        { "eval": "EVAL_MOOVE_0" },
        { "click": ".moove-gdpr-modal-save-settings" },
        { "waitForVisible": ".fc-cta-do-not-consent,.fc-cta-manage-options", "timeout": 4000, "optional": true },
        {
            "if": { "visible": ".fc-cta-do-not-consent,.fc-cta-manage-options" },
            "then": [
                { "click": ".fc-cta-do-not-consent,.fc-cta-manage-options" },
                {
                    "click": ".fc-preference-consent:checked,.fc-preference-legitimate-interest:checked",
                    "all": true,
                    "optional": true
                },
                { "waitForThenClick": ".fc-confirm-choices", "timeout": 2000, "optional": true },
                { "waitForVisible": ".fc-dialog-container", "check": "none", "timeout": 2000, "optional": true }
            ]
        }
    ],
    "test": [{ "visible": "#moove_gdpr_cookie_info_bar", "check": "none" }]
}
