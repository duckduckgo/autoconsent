{
    "name": "wix",
    "vendorUrl": "https://www.wix.com/",
    "cosmetic": false,
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "[data-comp-type=cookie-banner-root-wix],[data-hook=ccsu-banner-wrapper],[data-comp-type=cookie-banner-root-uou]"
        }
    ],
    "detectPopup": [
        {
            "visible": "[data-comp-type=cookie-banner-root-wix],[data-hook=ccsu-banner-wrapper],[data-comp-type=cookie-banner-root-uou]"
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": "[data-hook=consent-banner-apply-button]"
            },
            "then": [
                {
                    "click": "[data-hook=consent-banner-apply-button]"
                }
            ],
            "else": [
                {
                    "if": {
                        "exists": "[data-hook=ccsu-banner-accept]"
                    },
                    "then": [
                        {
                            "click": "[data-hook=ccsu-banner-accept]"
                        }
                    ],
                    "else": [
                        {
                            "click": "[data-hook=ccsu-banner-decline]"
                        }
                    ]
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "[data-comp-type=cookie-banner-root-uou]"
            },
            "then": [
                {
                    "wait": 1000
                },
                {
                    "if": {
                        "exists": "[data-hook=consent-banner-decline-all-button]"
                    },
                    "then": [
                        {
                            "click": "[data-hook=consent-banner-decline-all-button]"
                        }
                    ],
                    "else": [
                        {
                            "click": "[data-hook=consent-banner-settings-button]"
                        },
                        {
                            "waitForVisible": "[data-hook=consent-banner-settings-save-button]"
                        },
                        {
                            "click": "[data-hook=consent-banner-section-toggle-input]:checked:not(:disabled)",
                            "all": true,
                            "optional": true
                        },
                        {
                            "click": "[data-hook=consent-banner-settings-save-button]"
                        }
                    ]
                },
                {
                    "any": [
                        {
                            "waitForVisible": "[data-comp-type=cookie-banner-root-uou]",
                            "check": "none",
                            "timeout": 2000
                        },
                        {
                            "hide": "[data-comp-type=cookie-banner-root-uou]"
                        }
                    ]
                }
            ],
            "else": [
                {
                    "if": {
                        "exists": "[data-hook=ccsu-banner-decline-all]"
                    },
                    "then": [
                        {
                            "click": "[data-hook=ccsu-banner-decline-all]"
                        }
                    ],
                    "else": [
                        {
                            "hide": "[data-hook=ccsu-banner-wrapper]"
                        }
                    ]
                }
            ]
        }
    ]
}
