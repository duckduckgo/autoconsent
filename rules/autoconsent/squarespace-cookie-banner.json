{
    "name": "squarespace-cookie-banner",
    "prehideSelectors": [".cookie-banner-mount-point"],
    "detectCmp": [
        {
            "exists": ".cookie-banner-mount-point section[aria-label='Cookie banner'] :is(button.decline, button.manage)"
        }
    ],
    "detectPopup": [
        {
            "visible": ".cookie-banner-mount-point section[aria-label='Cookie banner']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".cookie-banner-mount-point button.accept"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": ".cookie-banner-mount-point button.decline"
            },
            "then": [
                {
                    "waitForThenClick": ".cookie-banner-mount-point button.decline"
                }
            ],
            "else": [
                {
                    "waitForThenClick": ".cookie-banner-mount-point button.manage"
                },
                {
                    "waitForVisible": ".cookie-banner-manager .manage-cookies-overlay"
                },
                {
                    "click": ".cookie-banner-manager .manage-cookies-overlay label.sqs-toggle--on input",
                    "all": true,
                    "optional": true
                },
                {
                    "waitForThenClick": ".cookie-banner-manager .manage-cookies-overlay button.save"
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": ".cookie-banner-mount-point section[aria-label='Cookie banner']",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
