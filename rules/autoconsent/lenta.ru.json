{
    "name": "lenta.ru",
    "vendorUrl": "https://lenta.ru/",
    "cosmetic": false,
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?lenta\\.ru/"
    },
    "prehideSelectors": [".js-cookies-notification"],
    "detectCmp": [{ "exists": ".js-cookies-notification .js-cookies-confirm" }],
    "detectPopup": [{ "visible": ".js-cookies-notification._active .js-cookies-confirm" }],
    "optIn": [{ "waitForThenClick": ".js-cookies-notification .js-cookies-confirm" }],
    "optOut": [{ "waitForThenClick": ".js-cookies-notification .js-cookies-confirm" }],
    "test": [{ "cookieContains": "cookies_notification=1" }]
}
