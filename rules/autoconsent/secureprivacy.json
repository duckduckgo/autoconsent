{
    "name": "secureprivacy",
    "cosmetic": false,
    "_metadata": {
        "vendorUrl": "https://secureprivacy.ai/"
    },
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": ["#ifrmCookieBanner", "#sp-decline"]
        }
    ],
    "detectPopup": [
        {
            "visible": "#ifrmCookieBanner"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#ifrmCookieBanner", "#sp-accept"]
        }
    ],
    "optOut": [
        {
            "wait": 500
        },
        {
            "waitForThenClick": ["#ifrmCookieBanner", "#sp-decline"],
            "comment": "Decline. Some configurations only render Accept, but the hidden Decline button still stores a rejection."
        }
    ],
    "test": []
}
