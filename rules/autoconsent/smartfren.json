{
    "name": "smartfren",
    "vendorUrl": "https://www.smartfren.com/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?smartfren\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "[class*='style_floatingWrapper'] img[alt='floating-cookie']"
        }
    ],
    "detectPopup": [
        {
            "visible": "[class*='style_floatingWrapper']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[class*='style_floatingWrapper'] button[class*='style_buttonClose']"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "[class*='style_floatingWrapper'] button[class*='style_buttonClose']"
        }
    ],
    "test": [
        {
            "visible": "[class*='style_floatingWrapper']",
            "check": "none"
        }
    ]
}
