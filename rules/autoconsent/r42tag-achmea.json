{
    "name": "r42tag-achmea",
    "runContext": {
        "main": true,
        "frame": false
    },
    "prehideSelectors": ["dialog#r42CookieBar"],
    "detectCmp": [{ "exists": "dialog#r42CookieBar button.cw-deny[value=\"popup_decline\"]" }],
    "detectPopup": [{ "visible": "dialog#r42CookieBar[open] button.cw-deny" }],
    "optIn": [{ "waitForThenClick": "dialog#r42CookieBar button.cw-accept[value=\"popup_accept\"]" }],
    "optOut": [{ "waitForThenClick": "dialog#r42CookieBar button.cw-deny[value=\"popup_decline\"]" }],
    "test": [{ "waitForVisible": "dialog#r42CookieBar[open] button.cw-deny", "timeout": 1000, "check": "none" }]
}
