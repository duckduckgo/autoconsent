{
    "name": "sitevision-cookie-consent",
    "vendorUrl": "https://www.sitevision.se/",
    "prehideSelectors": [".sv-cookie-consent-banner", "dialog.sv-cookie-consent-modal[open]"],
    "detectCmp": [{ "exists": ".sv-cookie-consent-banner, dialog.sv-cookie-consent-modal[open]" }],
    "detectPopup": [{ "visible": ".sv-cookie-consent-banner, dialog.sv-cookie-consent-modal[open]", "check": "any" }],
    "optIn": [
        {
            "waitForThenClick": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) form:has(input[type=hidden][name=analytics]) button[type=submit]"
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) form:has(input[type=hidden][name=necessary]) button[type=submit]"
            },
            "then": [
                {
                    "click": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) form:has(input[type=hidden][name=necessary]) button[type=submit]"
                }
            ],
            "else": [
                {
                    "waitForThenClick": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) button[type=button].env-button--link"
                },
                { "waitForVisible": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) form.env-form input[type=checkbox]" },
                {
                    "click": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) form.env-form input[type=checkbox]:checked:not(:disabled)",
                    "all": true,
                    "optional": true
                },
                { "waitForThenClick": ":is(.sv-cookie-consent-banner, dialog.sv-cookie-consent-modal) button[type=submit][form]" }
            ]
        }
    ]
}
