{
    "name": "ceneo",
    "prehideSelectors": ["#js_cookie-consent-banner"],
    "detectCmp": [{ "exists": "#js_cookie-consent-banner .js_cookie-consent-necessary" }],
    "detectPopup": [{ "visible": "#js_cookie-consent-banner .js_cookie-consent-necessary" }],
    "optIn": [{ "waitForThenClick": "#js_cookie-consent-banner .js_cookie-consent-agree" }],
    "optOut": [{ "waitForThenClick": "#js_cookie-consent-banner .js_cookie-consent-necessary" }],
    "test": [{ "waitForVisible": "#js_cookie-consent-banner", "timeout": 1000, "check": "none" }]
}
