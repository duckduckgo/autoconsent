{
    "name": "truevault-polaris",
    "vendorUrl": "https://www.truevault.com/",
    "prehideSelectors": [],
    "detectCmp": [{ "exists": ["#polaris-css-lockdown-container", ".polaris-banner.polaris-consent-widget"] }],
    "detectPopup": [{ "visible": ["#polaris-css-lockdown-container", ".polaris-banner.polaris-consent-widget"] }],
    "optIn": [
        {
            "waitForThenClick": ["#polaris-css-lockdown-container", ".polaris-consent-widget__actions > button.polaris-button:last-of-type"]
        }
    ],
    "optOut": [
        {
            "comment": "Manage is always the first action button; the X button accepts all in some variants",
            "waitForThenClick": [
                "#polaris-css-lockdown-container",
                ".polaris-consent-widget__actions > button.polaris-button:first-of-type:not(:last-of-type)"
            ]
        },
        { "waitForVisible": ["#polaris-css-lockdown-container", ".polaris-preferences-widget"] },
        {
            "click": ["#polaris-css-lockdown-container", ".polaris-preferences-widget input[type='checkbox']:checked:not(:disabled)"],
            "all": true,
            "optional": true
        },
        { "waitForThenClick": ["#polaris-css-lockdown-container", ".polaris-preferences-widget__save_button"] }
    ],
    "test": [{ "cookieContains": "\"adsPermitted\":false" }]
}
