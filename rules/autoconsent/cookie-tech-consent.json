{
    "name": "cookie-tech-consent",
    "prehideSelectors": ["#cookie-banner:has(button[onclick^=\"onAcceptSelectedCookies\"])"],
    "detectCmp": [{ "exists": "#cookie-banner button[onclick^=\"onAcceptSelectedCookies\"]" }],
    "detectPopup": [{ "visible": "#cookie-banner" }],
    "optIn": [{ "waitForThenClick": "#cookie-banner button[onclick^=\"onAcceptAllCookies\"]" }],
    "optOut": [
        {
            "if": { "exists": "#cookie-banner button[onclick^=\"onRefuseAllCookies\"]" },
            "then": [{ "waitForThenClick": "#cookie-banner button[onclick^=\"onRefuseAllCookies\"]" }],
            "else": [
                { "click": "#cookie-banner input[type=\"checkbox\"]:checked:not([disabled])", "all": true, "optional": true },
                { "waitForThenClick": "#cookie-banner button[onclick^=\"onAcceptSelectedCookies\"]" }
            ]
        }
    ],
    "test": [{ "cookieContains": "cookie_tech_consent=1" }]
}
