{
    "name": "skyscanner",
    "vendorUrl": "https://skyscanner.com",
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https://(www\\.)?skyscanner[\\.a-z]+/"
    },
    "prehideSelectors": [".consent-banner-wrapper"],
    "detectCmp": [
        {
            "exists": "#consentBannerContent"
        }
    ],
    "detectPopup": [
        {
            "visible": "#consentBannerContent"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[data-testid=consentBannerAcceptAll]"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "[data-testid=consentBannerRejectAll]"
        },
        {
            "waitForVisible": "#consentBannerContent",
            "check": "none"
        }
    ],
    "test": [
        {
            "eval": "EVAL_SKYSCANNER_TEST"
        }
    ]
}
