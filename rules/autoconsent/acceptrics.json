{
    "name": "acceptrics",
    "vendorUrl": "https://acceptrics.com/",
    "prehideSelectors": ["#acceptricsCookieBanner"],
    "detectCmp": [{ "exists": "#acceptricsCookieBanner" }],
    "detectPopup": [{ "visible": "#acceptricsCookieBanner" }],
    "optIn": [{ "waitForThenClick": "#acceptricsAcceptAllBtn" }],
    "optOut": [{ "waitForThenClick": "#acceptricsRejectAllBtn" }],
    "test": [{ "eval": "EVAL_ACCEPTRICS_TEST" }]
}
