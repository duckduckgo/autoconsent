{
    "name": "bandcamp.com",
    "runContext": {
        "urlPattern": "^https://([a-z0-9-]+\\.)?bandcamp\\.com"
    },
    "detectCmp": [
        {
            "exists": "body.enable-cookie-control"
        }
    ],
    "detectPopup": [
        {
            "visible": ["page-footer, #page-footer", ".cookie-dialog-initial"]
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["page-footer, #page-footer", ".cookie-dialog-initial button.g-button[type=\"submit\"]"]
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ["page-footer, #page-footer", ".cookie-dialog-initial button.g-button.outline"]
        },
        {
            "wait": 500
        }
    ],
    "test": [
        {
            "cookieContains": "cookie_preferences=%7B%22allow%22%3A%5B%5D"
        }
    ]
}
