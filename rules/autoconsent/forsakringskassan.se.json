{
    "name": "forsakringskassan.se",
    "vendorUrl": "https://www.forsakringskassan.se/",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?forsakringskassan\\.se/"
    },
    "prehideSelectors": [".fk-cookie-warning"],
    "detectCmp": [
        {
            "exists": ".fk-cookie-warning .cookie-warning-content"
        }
    ],
    "detectPopup": [
        {
            "visible": ".fk-cookie-warning .cookie-warning-content"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".fk-cookie-warning .cookie-warning-content button:nth-of-type(1)"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".fk-cookie-warning .cookie-warning-content button:nth-of-type(2)"
        }
    ],
    "test": [
        {
            "cookieContains": "fk_hide_cookie_warning=true"
        }
    ]
}
