{
    "name": "dpgmedia-nl",
    "prehideSelectors": ["#pg-shadow-host-dom"],
    "detectCmp": [
        {
            "exists": "#pg-shadow-host-dom"
        }
    ],
    "detectPopup": [
        {
            "visible": ["#pg-shadow-host-dom", "#pg-modal"]
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#pg-shadow-host-dom", "#pg-accept-btn"]
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": ["#pg-shadow-host-dom", "#pg-reject-btn"]
            },
            "then": [
                {
                    "click": ["#pg-shadow-host-dom", "#pg-reject-btn"]
                }
            ],
            "else": [
                {
                    "waitForThenClick": ["#pg-shadow-host-dom", "#pg-configure-btn"]
                },
                {
                    "waitForThenClick": ["#pg-shadow-host-dom", "#pg-reject-btn"]
                }
            ]
        }
    ]
}
