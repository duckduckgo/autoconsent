{
    "name": "TrustArc-newcm",
    "vendorUrl": "https://trustarc.com/",
    "prehideSelectors": [".truste_popframe.trustarc_newcm_container"],
    "detectCmp": [
        {
            "exists": [
                ".truste_popframe.trustarc_newcm_container",
                "a.required, a.call, button.required, button.call, button.trustarc-declineall-btn"
            ]
        }
    ],
    "detectPopup": [
        {
            "visible": [
                ".truste_popframe.trustarc_newcm_container",
                "a.required, a.call, button.required, button.call, button.trustarc-declineall-btn, button.trustarc-primary-btn.submit"
            ],
            "check": "any"
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": [".truste_popframe.trustarc_newcm_container", "a.call, button.call"]
            },
            "then": [
                {
                    "waitForThenClick": [".truste_popframe.trustarc_newcm_container", "a.call, button.call"]
                }
            ],
            "else": [
                {
                    "waitForThenClick": [".truste_popframe.trustarc_newcm_container", "button.trustarc-acceptall-btn"]
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": [".truste_popframe.trustarc_newcm_container", "a.required, button.required"]
            },
            "then": [
                {
                    "waitForThenClick": [".truste_popframe.trustarc_newcm_container", "a.required, button.required"]
                }
            ],
            "else": [
                {
                    "waitForThenClick": [".truste_popframe.trustarc_newcm_container", "button.trustarc-declineall-btn"]
                }
            ]
        }
    ],
    "test": [
        {
            "cookieContains": "notice_preferences=0:"
        }
    ]
}
