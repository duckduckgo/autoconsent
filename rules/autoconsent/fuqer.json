{
    "name": "fuqer",
    "vendorUrl": "https://www.fuqer.com/",
    "runContext": { "urlPattern": "^https?://(\\w+\\.)?fuqer\\.com/" },
    "prehideSelectors": [".cookies-block"],
    "detectCmp": [{ "exists": ".cookies-block button" }],
    "detectPopup": [{ "visible": ".cookies-block button" }],
    "optIn": [{ "waitForThenClick": ".cookies-block button", "retry": 10, "retryInterval": 500 }],
    "optOut": [{ "waitForThenClick": ".cookies-block button", "retry": 10, "retryInterval": 500 }],
    "test": [{ "cookieContains": "fuqer-allow-cookies=1" }]
}
