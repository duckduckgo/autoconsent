{
    "name": "smule",
    "vendorUrl": "https://www.smule.com/",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?smule\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "any": [
                {
                    "exists": "xpath///div[div/h3[normalize-space(.)='We Value Your Privacy']][div/button[normalize-space(.)='Manage Cookies']]"
                },
                { "exists": "xpath///div[span[contains(., 'By navigating the site, you consent to our use of cookies')]][button]" }
            ]
        }
    ],
    "detectPopup": [
        {
            "any": [
                {
                    "visible": "xpath///div[div/h3[normalize-space(.)='We Value Your Privacy']][div/button[normalize-space(.)='Manage Cookies']]"
                },
                { "visible": "xpath///div[span[contains(., 'By navigating the site, you consent to our use of cookies')]][button]" }
            ]
        }
    ],
    "optIn": [
        {
            "if": {
                "exists": "xpath///div[div/h3[normalize-space(.)='We Value Your Privacy']]/div/button[normalize-space(.)='Accept Cookies']"
            },
            "then": [
                {
                    "waitForThenClick": "xpath///div[div/h3[normalize-space(.)='We Value Your Privacy']]/div/button[normalize-space(.)='Accept Cookies']"
                }
            ],
            "else": [
                {
                    "waitForThenClick": "xpath///div[span[contains(., 'By navigating the site, you consent to our use of cookies')]]/button"
                }
            ]
        }
    ],
    "optOut": [
        {
            "if": {
                "exists": "xpath///div[div/h3[normalize-space(.)='We Value Your Privacy']]/div/button[normalize-space(.)='Manage Cookies']"
            },
            "then": [
                {
                    "waitForThenClick": "xpath///div[div/h3[normalize-space(.)='We Value Your Privacy']]/div/button[normalize-space(.)='Manage Cookies']"
                },
                { "waitForThenClick": "xpath///button[normalize-space(.)='Confirm My Choices']" }
            ],
            "else": [
                {
                    "waitForThenClick": "xpath///div[span[contains(., 'By navigating the site, you consent to our use of cookies')]]/button"
                }
            ]
        }
    ],
    "test": [
        { "visible": "xpath///div[span[contains(., 'By navigating the site, you consent to our use of cookies')]]", "check": "none" },
        { "any": [{ "cookieContains": "acceptedCookies%22:[]" }, { "cookieContains": "smule_cookie_banner_disabled=true" }] }
    ]
}
