{
    "name": "askas",
    "vendorUrl": "https://www.askas.se/",
    "prehideSelectors": ["#cookie_consent"],
    "detectCmp": [
        { "exists": "#cookie_consent" },
        { "exists": "#cookie_consent_manage_rec" },
        { "exists": "#cookie_consent_manager_confirm" }
    ],
    "detectPopup": [{ "visible": "#cookie_consent" }],
    "optIn": [{ "waitForThenClick": "#cookie_consent_manage_rec" }],
    "optOut": [
        {
            "if": { "exists": ".cookie_consent_manager_accept_req" },
            "then": [
                {
                    "if": { "visible": ".cookie_consent_manager_accept_req", "check": "none" },
                    "then": [
                        { "click": "#cookie_consent_manage" },
                        { "waitForVisible": ".cookie_consent_manager_accept_req", "timeout": 2000, "optional": true }
                    ]
                },
                { "click": ".cookie_consent_manager_accept_req" }
            ],
            "else": [
                {
                    "if": { "visible": "#cookie_consent_manager_confirm", "check": "none" },
                    "then": [
                        { "click": "#cookie_consent_manage" },
                        { "waitForVisible": "#cookie_consent_manager_confirm", "timeout": 2000 }
                    ]
                },
                { "click": "#cookie_consent_manager input[type=checkbox]:checked:not(:disabled)", "all": true, "optional": true },
                { "click": "#cookie_consent_manager_confirm" }
            ]
        }
    ],
    "test": [{ "cookieContains": "air_cookie_consent=" }, { "cookieContains": "false}" }]
}
