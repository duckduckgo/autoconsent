{
    "name": "solomasajistas.com",
    "vendorUrl": "https://www.solomasajistas.com/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?solomasajistas\\.com/"
    },
    "prehideSelectors": ["#opacity2"],
    "detectCmp": [{ "exists": "#opacity2 #barracookies" }],
    "detectPopup": [{ "visible": "#barracookies" }],
    "optIn": [{ "waitForThenClick": "#barracookies .cookiesoptions a:first-child" }],
    "optOut": [
        { "waitForThenClick": "#barracookies .cookiesOption" },
        { "waitForVisible": "#barracookies2" },
        { "click": "#cboxid input[type=checkbox]:checked:not([disabled])", "all": true, "optional": true },
        { "click": "#centerbutton a.colorboton:first-child" }
    ],
    "test": [{ "visible": "#opacity2", "check": "none" }]
}
