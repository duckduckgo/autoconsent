{
    "name": "livsmedelsverket",
    "vendorUrl": "https://www.livsmedelsverket.se/",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?livsmedelsverket\\.se/"
    },
    "prehideSelectors": ["#cookie-banner"],
    "detectCmp": [{ "exists": "#cookie-banner #cookie-consent-settings" }],
    "detectPopup": [{ "visible": "#cookie-banner #cookie-consent-view" }],
    "optIn": [{ "waitForThenClick": "#cookie-banner #cookie-consent-accept" }],
    "optOut": [
        { "waitForThenClick": "#cookie-banner #cookie-consent-settings" },
        { "waitForVisible": "#cookie-banner #cookie-settings-view" },
        { "click": "#cookie-form input[type=checkbox]:checked:not(:disabled)", "all": true, "optional": true },
        { "click": "#cookie-banner #cookie-settings-save" }
    ],
    "test": [{ "cookieContains": "analytic%3A0" }]
}
