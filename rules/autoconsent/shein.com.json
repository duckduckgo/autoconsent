{
    "name": "shein.com",
    "vendorUrl": "https://shein.com/",
    "runContext": {
        "urlPattern": "^https?://([a-z]+\\.)?shein\\.com/"
    },
    "prehideSelectors": ["body > div[class*=_shein_privacy]"],
    "detectCmp": [
        {
            "exists": "body > div[class*=_shein_privacy_agreement] .cmp_c_1102 > .cmp_c_1"
        }
    ],
    "detectPopup": [
        {
            "visible": "body > div[class*=_shein_privacy_agreement] .cmp_c_1102 > .cmp_c_1"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "body > div[class*=_shein_privacy_agreement] .cmp_c_1102 > .cmp_c_2"
        }
    ],
    "optOut": [
        {
            "if": {
                "visible": "body > div[class*=_shein_privacy_agreement] .cmp_c_1102 > .cmp_c_3"
            },
            "then": [
                {
                    "click": "body > div[class*=_shein_privacy_agreement] .cmp_c_1102 > .cmp_c_3"
                }
            ],
            "else": [
                {
                    "click": "body > div[class*=_shein_privacy_agreement] .cmp_c_1102 > .cmp_c_1"
                },
                {
                    "waitForVisible": "body > div[class*=_shein_privacy_preference] .cmp_c_1204"
                },
                {
                    "if": {
                        "visible": "body > div[class*=_shein_privacy_preference] .cmp_c_1204 > .cmp_c_3"
                    },
                    "then": [
                        {
                            "click": "body > div[class*=_shein_privacy_preference] .cmp_c_1204 > .cmp_c_3"
                        }
                    ],
                    "else": [
                        {
                            "click": "body > div[class*=_shein_privacy_preference] label:has(> input:checked) > .slider",
                            "all": true,
                            "optional": true
                        },
                        {
                            "click": "body > div[class*=_shein_privacy_preference] .cmp_c_1204 > .cmp_c_5"
                        }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": "body > div[class*=_shein_privacy] .cmp_c_1102 > .cmp_c_1",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
