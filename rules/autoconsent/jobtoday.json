{
    "name": "jobtoday",
    "vendorUrl": "https://jobtoday.com/",
    "runContext": {
        "urlPattern": "^https?://(www\\.)?jobtoday\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "[data-testid=modal_cookie-consent]" }],
    "detectPopup": [{ "visible": "[data-testid=modal_cookie-consent]" }],
    "optIn": [{ "waitForThenClick": "[data-testid=modal_cookie-consent-accept-all]" }],
    "optOut": [
        { "waitForThenClick": "[data-testid=modal_cookie-consent] .modal-bottom button.jt-btn-outline" },
        { "waitForVisible": "[data-testid=modal_cookie-consent] #marketingConsent" },
        { "click": "[data-testid=modal_cookie-consent] input[type=checkbox]:checked:not([disabled])", "all": true, "optional": true },
        { "waitForThenClick": "[data-testid=modal_cookie-consent-accept]" }
    ],
    "test": [{ "cookieContains": "jt-cookie-consent-extended=%7B%22ad_storage%22%3Afalse%2C%22analytics_storage%22%3Afalse" }]
}
