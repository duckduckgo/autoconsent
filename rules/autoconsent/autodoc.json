{
    "name": "autodoc",
    "detectCmp": [{ "exists": "div[data-popup-cookies][data-terms-cookies-popup-common] button[data-cookies=\"disallow_all_cookies\"]" }],
    "detectPopup": [
        { "visible": "div[data-popup-cookies][data-terms-cookies-popup-common] button[data-cookies=\"disallow_all_cookies\"]" }
    ],
    "optIn": [
        { "waitForThenClick": "div[data-popup-cookies][data-terms-cookies-popup-common] button[data-cookies=\"allow_all_cookies\"]" }
    ],
    "optOut": [
        { "waitForVisible": "div[data-popup-cookies][data-terms-cookies-popup-common] button[data-cookies=\"disallow_all_cookies\"]" },
        { "eval": "EVAL_AUTODOC_REJECT" }
    ],
    "prehideSelectors": ["div[data-popup-cookies][data-terms-cookies-popup-common]"],
    "test": [{ "wait": 2000, "comment": "rejecting submits a form and reloads the page" }, { "eval": "EVAL_AUTODOC_TEST" }]
}
