{
    "name": "energiedirect",
    "vendorUrl": "https://www.energiedirect.nl/",
    "runContext": {
        "urlPattern": "^https?://(\\w+\\.)?energiedirect\\.nl/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": "wl-cookiewall [data-automation-id=\"cookiewall-reject\"]" }],
    "detectPopup": [{ "visible": ["wl-cookiewall crnt-dialog", "dialog[open]"] }],
    "optIn": [{ "waitForThenClick": "wl-cookiewall [data-automation-id=\"cookiewall-accept\"]" }],
    "optOut": [{ "waitForThenClick": "wl-cookiewall [data-automation-id=\"cookiewall-reject\"]" }],
    "test": [{ "cookieContains": "consentLevel=1" }]
}
