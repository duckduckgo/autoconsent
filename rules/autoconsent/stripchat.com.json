{
    "name": "stripchat.com",
    "vendorUrl": "https://unknown",
    "cosmetic": false,
    "prehideSelectors": ["[data-testid=\"CookiesReminder\"]"],
    "detectCmp": [
        {
            "visible": "[data-testid=\"CookiesReminder\"] [data-testid=\"CookiesManage\"]"
        }
    ],
    "detectPopup": [
        {
            "visible": "[data-testid=\"CookiesReminder\"]"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "[data-testid=\"CookiesReminder\"] [data-testid=\"CookiesAcceptAll\"]"
        }
    ],
    "optOut": [
        {
            "waitFor": "body:not(.disable-transition)",
            "timeout": 5000,
            "optional": true
        },
        {
            "waitForThenClick": "[data-testid=\"CookiesReminder\"] [data-testid=\"CookiesManage\"]"
        },
        {
            "waitForVisible": "dialog[open] .cookies-select-modal",
            "timeout": 1500,
            "optional": true
        },
        {
            "if": {
                "visible": "dialog[open] .cookies-select-modal",
                "check": "none"
            },
            "then": [
                {
                    "click": "[data-testid=\"CookiesReminder\"] [data-testid=\"CookiesManage\"]"
                }
            ]
        },
        {
            "waitForThenClick": "dialog[open] .cookies-select-modal .cookies-select-modal__buttons .ds-btn-apply-2-ds"
        }
    ],
    "test": [
        {
            "wait": 500
        },
        {
            "cookieContains": " c=%7B%22essential"
        }
    ]
}
