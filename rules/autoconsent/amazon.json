{
    "name": "amazon.com",
    "vendorUrl": "https://amazon.com/",
    "prehideSelectors": ["#sp-cc-wrapper,[data-action=sp-cc],span[data-action=\"sp-cc\"][data-sp-cc*=\"rejectAllAction\"]"],
    "detectCmp": [{ "exists": "#sp-cc-wrapper,[data-action=sp-cc],span[data-action=\"sp-cc\"][data-sp-cc*=\"rejectAllAction\"]" }],
    "detectPopup": [
        { "visible": "#sp-cc-wrapper *,[data-action=sp-cc],span[data-action=\"sp-cc\"][data-sp-cc*=\"rejectAllAction\"]", "check": "any" }
    ],
    "optIn": [{ "waitForVisible": "#sp-cc-accept" }, { "waitForThenClick": "#sp-cc-accept", "retry": 5, "retryInterval": 1000 }],
    "optOut": [
        { "waitForVisible": "#sp-cc-rejectall-link" },
        { "waitForThenClick": "#sp-cc-rejectall-link", "retry": 5, "retryInterval": 1000 }
    ]
}
