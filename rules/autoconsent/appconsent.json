{
    "name": "AppConsent",
    "prehideSelectors": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']"],
    "detectCmp": [
        {
            "exists": "script[src*='cdn.appconsent.io/tcf2-clear/'][src*='core.bundle.js']"
        }
    ],
    "detectPopup": [
        {
            "visible": "iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__acceptAll"]
        }
    ],
    "optOut": [
        {
            "waitFor": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__refuseAll, .button__skip"]
        },
        {
            "if": { "exists": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__refuseAll"] },
            "then": [{ "click": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__refuseAll"] }],
            "else": [{ "click": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__skip"] }]
        }
    ],
    "test": [
        {
            "waitForVisible": "iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
