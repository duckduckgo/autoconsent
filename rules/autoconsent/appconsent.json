{
    "name": "AppConsent",
    "prehideSelectors": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']"],
    "detectCmp": [
        {
            "exists": "script[src*='cdn.appconsent.io/tcf2-clear/'][src*='core.bundle.js']"
        }
    ],
    "detectPopup": [
        {
            "visible": "iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__acceptAll"]
        }
    ],
    "optOut": [
        {
            "waitFor": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__skip, .button__refuseAll"]
        },
        {
            "if": {
                "exists": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__skip"]
            },
            "then": [
                {
                    "click": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__skip"]
                }
            ],
            "else": [
                {
                    "click": ["iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']", ".button__refuseAll"]
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": "iframe[srcdoc*='cdn.appconsent.io/tcf2-clear/']",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
