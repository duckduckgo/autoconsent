{
    "name": "AppConsent",
    "prehideSelectors": ["iframe[title*='onsent']"],
    "detectCmp": [
        {
            "exists": "script[src*='cdn.appconsent.io/tcf2-clear/'][src*='core.bundle.js']"
        }
    ],
    "detectPopup": [
        {
            "visible": "iframe[title*='onsent']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["iframe[title*='onsent']", ".button__acceptAll"]
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ["iframe[title*='onsent']", ".button__refuseAll, .button__skip"]
        }
    ],
    "test": [
        {
            "waitForVisible": "iframe[title*='onsent']",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
