{
    "name": "AppConsent",
    "prehideSelectors": ["#appconsent > iframe"],
    "detectCmp": [
        {
            "exists": "script[src*='cdn.appconsent.io/tcf2-clear/'][src*='core.bundle.js']"
        }
    ],
    "detectPopup": [
        {
            "visible": "#appconsent > iframe"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["#appconsent > iframe", ".button__acceptAll"]
        }
    ],
    "optOut": [
        {
            "waitFor": ["#appconsent > iframe", ".button__refuseAll, .button__skip"]
        },
        {
            "exists": [
                "#appconsent > iframe",
                "body",
                "xpath/.//button[contains(@class,'button__skip') or contains(@class,'button__refuseAll')][contains(., 'abonn') or contains(., 'Abonn') or contains(., 'abbon') or contains(., 'Abbon') or contains(., 'subscri') or contains(., 'Subscri') or contains(., 'suscri') or contains(., 'Suscri')]"
            ],
            "negated": true
        },
        {
            "if": { "exists": ["#appconsent > iframe", ".button__refuseAll"] },
            "then": [{ "click": ["#appconsent > iframe", ".button__refuseAll"] }],
            "else": [{ "click": ["#appconsent > iframe", ".button__skip"] }]
        }
    ],
    "test": [
        {
            "waitForVisible": "#appconsent > iframe",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
