{
    "name": "AppConsent",
    "prehideSelectors": ["iframe[srcdoc*='appconsent.io/tcf2-clear']"],
    "detectCmp": [
        {
            "exists": "script[src*='cdn.appconsent.io/tcf2-clear/'][src*='core.bundle.js']"
        }
    ],
    "detectPopup": [
        {
            "visible": "iframe[srcdoc*='appconsent.io/tcf2-clear']"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__acceptAll"]
        }
    ],
    "optOut": [
        {
            "waitForVisible": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__acceptAll"]
        },
        {
            "if": { "exists": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__refuseAll"] },
            "then": [
                {
                    "waitForThenClick": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__refuseAll"]
                }
            ],
            "else": [
                {
                    "if": { "exists": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__skip"] },
                    "then": [
                        {
                            "waitForThenClick": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__skip"]
                        }
                    ],
                    "else": [
                        {
                            "waitForThenClick": ["iframe[srcdoc*='appconsent.io/tcf2-clear']", ".button__close"]
                        }
                    ]
                }
            ]
        }
    ],
    "test": [
        {
            "waitForVisible": "iframe[srcdoc*='appconsent.io/tcf2-clear']",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
