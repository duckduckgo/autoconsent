{
    "name": "educastur-alojaweb",
    "vendorUrl": "https://alojaweb.educastur.es/",
    "cosmetic": true,
    "runContext": {
        "urlPattern": "^https?://alojaweb\\.educastur\\.es/"
    },
    "prehideSelectors": ["#educacentrosPrivacyPolicyLayer"],
    "detectCmp": [{ "exists": "#educacentrosPrivacyPolicyLayer" }],
