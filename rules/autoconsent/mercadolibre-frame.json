{
    "name": "mercadolibre-frame",
    "vendorUrl": "https://www.mercadolibre.com/",
    "cosmetic": false,
    "intermediate": true,
    "runContext": {
        "main": false,
        "frame": true,
        "urlPattern": "^https://www\\.mercado(libre|livre|pago)\\.[a-z.]+/"
    },
    "prehideSelectors": [],
    "detectCmp": [{ "exists": ".pp-cookies-item-switch .andes-ui-switch" }, { "eval": "EVAL_MERCADOLIBRE_CROSS_ORIGIN_PARENT" }],
    "detectPopup": [{ "visible": ".pp-cookies-item-switch .andes-ui-switch" }],
    "optIn": [
        { "waitFor": ".pp-cookies-item-switch .andes-ui-switch:not(.andes-ui-switch--disabled)", "timeout": 20000 },
        { "eval": "EVAL_MERCADOLIBRE_SAVE" }
    ],
    "optOut": [
        {
            "comment": "toggles are server-rendered as disabled until the page hydrates, which can take over 10s",
            "waitFor": ".pp-cookies-item-switch .andes-ui-switch:not(.andes-ui-switch--disabled)",
            "timeout": 20000
        },
        {
            "if": { "exists": ".pp-cookies-item-switch .andes-ui-switch[data-andes-state=checked]:not(.andes-ui-switch--disabled)" },
            "then": [
                {
                    "waitForThenClick": ".pp-cookies-item-switch .andes-ui-switch[data-andes-state=checked]:not(.andes-ui-switch--disabled)",
                    "all": true,
                    "retry": 5,
                    "retryInterval": 500
                }
            ]
        },
        {
            "waitForVisible": ".pp-cookies-item-switch .andes-ui-switch[data-andes-state=checked]:not(.andes-ui-switch--disabled)",
            "check": "none",
            "timeout": 3000
        },
        { "eval": "EVAL_MERCADOLIBRE_SAVE" }
    ]
}
