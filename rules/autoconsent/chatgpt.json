{
    "name": "chatgpt",
    "_metadata": {
        "vendorUrl": "https://chatgpt.com/"
    },
    "cosmetic": false,
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https://(www\\.)?chatgpt\\.com/"
    },
    "prehideSelectors": ["div[role=\"dialog\"]:has(> div a[href*=\"cookie-policy\"])"],
    "detectCmp": [
        {
            "exists": "div[role=\"dialog\"]:has(> div a[href*=\"cookie-policy\"])"
        }
    ],
    "detectPopup": [
        {
            "visible": "div[role=\"dialog\"]:has(> div a[href*=\"cookie-policy\"])"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "div[role=\"dialog\"]:has(> div a[href*=\"cookie-policy\"]) button.btn-primary"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "div[role=\"dialog\"]:has(> div a[href*=\"cookie-policy\"]) button.btn-secondary",
            "comment": "Reject non-essential"
        }
    ],
    "test": [{ "cookieContains": "oai-allow-ne=false" }]
}
