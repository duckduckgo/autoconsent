{
    "name": "opencmp",
    "vendorUrl": "https://opencmp.net/",
    "detectCmp": [{ "exists": [".cmp-root-container", "#cmp_consentDialog .cmp_ui .cmp_mainButtons"] }],
    "detectPopup": [{ "visible": [".cmp-root-container", "#cmp_consentDialog .cmp_ui"] }],
    "optIn": [{ "waitForThenClick": [".cmp-root-container", ".cmp_mainButtons .cmp-button-accept-all"] }],
    "optOut": [
        {
            "if": { "exists": [".cmp-root-container", ".cmp_mainButtons .cmp_primaryButtonLine .cmp_button:not(.cmp-button-accept-all)"] },
            "then": [
                { "click": [".cmp-root-container", ".cmp_mainButtons .cmp_primaryButtonLine .cmp_button:not(.cmp-button-accept-all)"] }
            ],
            "else": [
                { "click": [".cmp-root-container", ".cmp_mainButtons .cmp_saveLink a"] },
                { "waitForVisible": [".cmp-root-container", ".cmp_page-settings"] },
                { "click": [".cmp-root-container", ".cmp_mainButtons .cmp_saveLink a"] }
            ]
        }
    ],
    "test": [{ "waitForVisible": [".cmp-root-container", "#cmp_consentDialog .cmp_ui"], "check": "none", "timeout": 3000 }]
}
