{
    "name": "povr",
    "vendorUrl": "https://povr.com/",
    "cosmetic": false,
    "runContext": {
        "urlPattern": "^https://povr\\.com/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": ".alert .accept-cookies"
        }
    ],
    "detectPopup": [
        {
            "visible": ".alert .accept-cookies"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": ".alert .accept-cookies"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": ".alert:has(.accept-cookies) .alert__close[data-dsm=cookie]",
            "retry": 10,
            "retryInterval": 500
        }
    ],
    "test": [
        {
            "waitForVisible": ".alert .accept-cookies",
            "timeout": 1000,
            "check": "none"
        }
    ]
}
