{
    "name": "effenaar",
    "vendorUrl": "https://www.effenaar.nl/",
    "runContext": {
        "main": true,
        "frame": false,
        "urlPattern": "^https?://(www\\.)?effenaar\\.nl/"
    },
    "prehideSelectors": [],
    "detectCmp": [
        {
            "exists": "#__next button.button-yes + button.button-no"
        }
    ],
    "detectPopup": [
        {
            "visible": "#__next button.button-yes + button.button-no"
        }
    ],
    "optIn": [
        {
            "waitForThenClick": "#__next button.button-yes"
        }
    ],
    "optOut": [
        {
            "waitForThenClick": "#__next button.button-yes + button.button-no",
            "comment": "Nee, bedankt"
        }
    ],
    "test": [
        {
            "waitForVisible": "#__next button.button-yes + button.button-no",
            "timeout": 2000,
            "check": "none"
        }
    ]
}
