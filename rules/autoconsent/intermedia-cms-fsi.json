    "prehideSelectors": ["#stopka-polityka"],
    "detectCmp": [
        {
            "exists": "#stopka-polityka #stopka-polityka-zamknij"
        }
    ],
    "detectPopup": [
        {
            "visible": "#stopka-polityka"
        }
    ],
    "optIn": [
