{
    "compilerOptions": {
        "target": "es2021",
        "lib": ["es2021", "es2022.error", "dom", "dom.iterable", "dom.asynciterable", "webworker.importscripts", "scripthost"],
        "allowJs": true,
        "checkJs": true,
        "resolveJsonModule": true,
        "moduleResolution": "NodeNext",
        "noImplicitAny": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "module": "NodeNext"
    },
    "exclude": ["node_modules/*", "dist/*"]
}
